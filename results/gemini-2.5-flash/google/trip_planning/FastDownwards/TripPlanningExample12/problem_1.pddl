(define (problem tripplanningexample12)
    (:domain trip-planning)
    (:init
        (at home)
        (current_day day0)

        ; Day sequence up to day 15 (inclusive, 16 day objects total from day0)
        (next_day day0 day1)
        (next_day day1 day2)
        (next_day day2 day3)
        (next_day day3 day4)
        (next_day day4 day5)
        (next_day day5 day6)
        (next_day day6 day7)
        (next_day day7 day8)
        (next_day day8 day9)
        (next_day day9 day10)
        (next_day day10 day11)
        (next_day day11 day12)
        (next_day day12 day13)
        (next_day day13 day14)
        (next_day day14 day15)

        ; Direct flights between cities (symmetric connections)
        (has_flight amsterdam tallinn)
        (has_flight tallinn amsterdam)
        (has_flight valencia amsterdam)
        (has_flight amsterdam valencia)

        ; Implicit flights from home to any starting city
        (has_flight home valencia)
        (has_flight home amsterdam)
        (has_flight home tallinn)

        ; Tallinn meeting window (day 9 to day 15, inclusive)
        (day_is_between_9_and_15 day9)
        (day_is_between_9_and_15 day10)
        (day_is_between_9_and_15 day11)
        (day_is_between_9_and_15 day12)
        (day_is_between_9_and_15 day13)
        (day_is_between_9_and_15 day14)
        (day_is_between_9_and_15 day15)
    )
    (:goal (and
        (visited valencia)
        (visited amsterdam)
        (visited tallinn)
        (tallinn_meeting_met)
        ; The current_day must be one of the defined day objects (day0 to day15),
        ; implicitly respecting the 15-day total limit by the structure of next_day predicates.
    ))
)