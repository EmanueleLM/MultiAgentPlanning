  ;; Actions for meeting friends in Paris, only possible on specified days
  (:action meet_friends_on_day1
    :parameters (?p - person)
    :precondition (and
      (at ?p city_paris day1)
      (current_time day1)
      (not (friends_met_in_paris))
    )
