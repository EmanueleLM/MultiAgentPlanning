(define (domain trip_planning_example_42)
  (:requirements :strips :typing :negative-preconditions :action-costs)
  (:types
    person city time - object
  )
  (:predicates
    (at ?p - person ?c - city ?t - time)
    (connected ?c1 - city ?c2 - city)
    (current_time ?t - time)
    (next_time ?t1 - time ?t2 - time)
    (visited_paris_day_0)
    (visited_paris_day_1)
    (visited_paris_day_2)
    (visited_paris_day_3)
    (visited_paris_day_4)
    (visited_mykonos_day_0)
    (visited_mykonos_day_1)
    (visited_mykonos_day_2)
    (visited_mykonos_day_3)
    (visited_mykonos_day_4)
    (visited_nice_day_0)
    (visited_nice_day_1)
    (visited_nice_day_2)
    (visited_nice_day_3)
    (visited_nice_day_4)
    (visited_nice_day_5)
    (friends_met_in_paris)
  )

  (:action travel
    :parameters (?p - person ?from - city ?to - city ?t1 - time ?t2 - time)
    :precondition (and
      (at ?p ?from ?t1)
      (connected ?from ?to)
      (current_time ?t1)
      (next_time ?t1 ?t2)
    )
    :effect (and
      (not (at ?p ?from ?t1))
      (at ?p ?to ?t2)
      (not (current_time ?t1))
      (current_time ?t2)
      (increase (total-cost) 1)
    )
  )

  ;; Actions for staying in Paris, advancing a counter predicate
  (:action stay_in_paris_day_1
    :parameters (?p - person ?t1 - time ?t2 - time)
    :precondition (and
      (at ?p city_paris ?t1)
      (current_time ?t1)
      (next_time ?t1 ?t2)
      (visited_paris_day_0)
    )
    :effect (and
      (not (at ?p city_paris ?t1))
      (at ?p city_paris ?t2)
      (not (current_time ?t1))
      (current_time ?t2)
      (not (visited_paris_day_0))
      (visited_paris_day_1)
      (increase (total-cost) 1)
    )
  )
