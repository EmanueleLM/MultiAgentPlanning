(define (problem calendar_scheduling_example_13)
    (:domain calendar_scheduling)
    (:objects
        t0900 t0930 t1000 t1030 t1100 t1130 t1200 t1230 t1300 t1330 t1400 t1430 t1500 t1530 t1600 t1630 - time_point
    )
    (:init
        (= (total-cost) 0)
        ;; Time progression (30-minute intervals from 9:00 to 17:00)
        (next_time t0900 t0930)
        (next_time t0930 t1000)
        (next_time t1000 t1030)
        (next_time t1030 t1100)
        (next_time t1100 t1130)
        (next_time t1130 t1200)
        (next_time t1200 t1230)
        (next_time t1230 t1300)
        (next_time t1300 t1330)
        (next_time t1330 t1400)
        (next_time t1400 t1430)
        (next_time t1430 t1500)
        (next_time t1500 t1530)
        (next_time t1530 t1600)
        (next_time t1600 t1630)
        ; t1630 is the last possible start time for a 30-min meeting (ends at 17:00)

        ;; Gerald's availability based on busy times: 9:00-9:30, 13:00-14:00, 15:00-15:30, 16:00-17:00
        (is_available gerald t0930)
        (is_available gerald t1000)
        (is_available gerald t1030)
        (is_available gerald t1100)
        (is_available gerald t1130)
        (is_available gerald t1200)
        (is_available gerald t1230)
        (is_available gerald t1400)
        (is_available gerald t1430)
        (is_available gerald t1530)

        ;; Roy's availability (free the entire day)
        (is_available roy t0900)
        (is_available roy t0930)
        (is_available roy t1000)
        (is_available roy t1030)
        (is_available roy t1100)
        (is_available roy t1130)
        (is_available roy t1200)
        (is_available roy t1230)
        (is_available roy t1300)
        (is_available roy t1330)
        (is_available roy t1400)
        (is_available roy t1430)
        (is_available roy t1500)
        (is_available roy t1530)
        (is_available roy t1600)
        (is_available roy t1630)

        ;; Barbara's availability based on busy times: 9:30-10:00, 11:30-14:00, 14:30-15:00, 15:30-17:00
        (is_available barbara t0900)
        (is_available barbara t1000)
        (is_available barbara t1030)
        (is_available barbara t1100)
        (is_available barbara t1400)
        (is_available barbara t1500)

        ;; Gerald's preference: slots starting at or after 13:00 are preferred
        (is_preferred_slot t1300)
        (is_preferred_slot t1330)
        (is_preferred_slot t1400)
        (is_preferred_slot t1430)
        (is_preferred_slot t1500)
        (is_preferred_slot t1530)
        (is_preferred_slot t1600)
        (is_preferred_slot t1630)

        ;; Initialize has_preferred_option:
        ;; As t1400 is available for all participants and is a preferred slot, this predicate is true.
        (has_preferred_option)
    )
    (:goal (meeting_scheduled))
    (:metric minimize (total-cost))
)