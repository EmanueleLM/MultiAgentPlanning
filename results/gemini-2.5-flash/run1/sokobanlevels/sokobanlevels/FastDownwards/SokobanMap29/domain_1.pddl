(define (domain sokoban_map29)
    (:requirements :strips :typing :negative-preconditions)
    (:types agent box location)
    (:predicates
        (at_player ?l - location)
        (at_box ?b - box ?l - location)
        (is_goal ?l - location)
        (is_wall ?l - location)
        (next_right ?l1 - location ?l2 - location)
        (next_left ?l1 - location ?l2 - location)
        (clear ?l - location)
    )

    (:action move_player_right
        :parameters (?l_from - location ?l_to - location)
        :precondition (and (at_player ?l_from)
                           (next_right ?l_from ?l_to)
                           (clear ?l_to)
                           (not (is_wall ?l_to)))
        :effect (and (not (at_player ?l_from))
                     (at_player ?l_to)
                     (clear ?l_from)
                     (not (clear ?l_to))))

    (:action move_player_left
        :parameters (?l_from - location ?l_to - location)
        :precondition (and (at_player ?l_from)
                           (next_left ?l_from ?l_to)
                           (clear ?l_to)
                           (not (is_wall ?l_to)))
        :effect (and (not (at_player ?l_from))
                     (at_player ?l_to)
                     (clear ?l_from)
                     (not (clear ?l_to))))

    (:action push_box_right
        :parameters (?b - box ?l_player - location ?l_box - location ?l_new_box - location)
        :precondition (and (at_player ?l_player)
                           (at_box ?b ?l_box)
                           (next_right ?l_player ?l_box)
                           (next_right ?l_box ?l_new_box)
                           (clear ?l_new_box)
                           (not (is_wall ?l_new_box)))
        :effect (and (not (at_player ?l_player))
                     (at_player ?l_box)
                     (not (at_box ?b ?l_box))
                     (at_box ?b ?l_new_box)
                     (clear ?l_player)
                     (not (clear ?l_new_box))))

    (:action push_box_left
        :parameters (?b - box ?l_player - location ?l_box - location ?l_new_box - location)
        :precondition (and (at_player ?l_player)
                           (at_box ?b ?l_box)
                           (next_left ?l_player ?l_box)
                           (next_left ?l_box ?l_new_box)
                           (clear ?l_new_box)
                           (not (is_wall ?l_new_box)))
        :effect (and (not (at_player ?l_player))
                     (at_player ?l_box)
                     (not (at_box ?b ?l_box))
                     (at_box ?b ?l_new_box)
                     (clear ?l_player)
                     (not (clear ?l_new_box))))
)