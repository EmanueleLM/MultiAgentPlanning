(define (problem calendar_scheduling_example_29)
  (:domain calendar_scheduling)
  (:objects
    madison diana shirley - person
    t0900 t0930 t1000 t1030 t1100 t1130 t1200 t1230 t1300 t1330 t1400 t1430 t1500 t1530 t1600 t1630 t1700 - time
  )
  (:init
    ;; Time sequence
    (next t0900 t0930)
    (next t0930 t1000)
    (next t1000 t1030)
    (next t1030 t1100)
    (next t1100 t1130)
    (next t1130 t1200)
    (next t1200 t1230)
    (next t1230 t1300)
    (next t1300 t1330)
    (next t1330 t1400)
    (next t1400 t1430)
    (next t1430 t1500)
    (next t1500 t1530)
    (next t1530 t1600)
    (next t1600 t1630)
    (next t1630 t1700)

    ;; Madison is free except 09:30-10:00 and 11:30-12:00
    (is_free madison t0900 t0930)
    (is_free madison t1000 t1030)
    (is_free madison t1030 t1100)
    (is_free madison t1100 t1130)
    (is_free madison t1200 t1230)
    (is_free madison t1230 t1300)
    (is_free madison t1300 t1330)
    (is_free madison t1330 t1400)
    (is_free madison t1400 t1430)
    (is_free madison t1430 t1500)
    (is_free madison t1500 t1530)
    (is_free madison t1530 t1600)
    (is_free madison t1600 t1630)
    (is_free madison t1630 t1700)

    ;; Diana is free except 11:00-11:30 and 13:00-13:30
    (is_free diana t0900 t0930)
    (is_free diana t0930 t1000)
    (is_free diana t1000 t1030)
    (is_free diana t1030 t1100)
    (is_free diana t1130 t1200)
    (is_free diana t1200 t1230)
    (is_free diana t1230 t1300)
    (is_free diana t1330 t1400)
    (is_free diana t1400 t1430)
    (is_free diana t1430 t1500)
    (is_free diana t1500 t1530)
    (is_free diana t1530 t1600)
    (is_free diana t1600 t1630)
    (is_free diana t1630 t1700)

    ;; Shirley is free except 09:00-12:00, 13:30-15:00, and 15:30-17:00
    (is_free shirley t1200 t1230)
    (is_free shirley t1230 t1300)
    (is_free shirley t1300 t1330)
    (is_free shirley t1500 t1530)
  )
  (:goal (meeting_scheduled))
)