(define (problem calendar_scheduling_39)
  (:domain calendar_scheduling)
  (:objects
    emily victoria nancy - person
    slot_0900 slot_0930 slot_1000 slot_1030 slot_1100 slot_1130 slot_1200 slot_1230
    slot_1300 slot_1330 slot_1400 slot_1430 slot_1500 slot_1530 slot_1600 slot_1630 - timeslot
  )
  (:init
    (= (total-cost) 0)
    (at_slot slot_0900)
    (next slot_0900 slot_0930)
    (next slot_0930 slot_1000)
    (next slot_1000 slot_1030)
    (next slot_1030 slot_1100)
    (next slot_1100 slot_1130)
    (next slot_1130 slot_1200)
    (next slot_1200 slot_1230)
    (next slot_1230 slot_1300)
    (next slot_1300 slot_1330)
    (next slot_1330 slot_1400)
    (next slot_1400 slot_1430)
    (next slot_1430 slot_1500)
    (next slot_1500 slot_1530)
    (next slot_1530 slot_1600)
    (next slot_1600 slot_1630)

    ;; Emily is free the entire day (9:00 - 17:00)
    (free emily slot_0900) (free emily slot_0930) (free emily slot_1000) (free emily slot_1030)
    (free emily slot_1100) (free emily slot_1130) (free emily slot_1200) (free emily slot_1230)
    (free emily slot_1300) (free emily slot_1330) (free emily slot_1400) (free emily slot_1430)
    (free emily slot_1500) (free emily slot_1530) (free emily slot_1600) (free emily slot_1630)

    ;; Victoria busy periods: 13:30-14:00 (slot_1330), 14:30-15:30 (slot_1430, slot_1500), 16:30-17:00 (slot_1630)
    (free victoria slot_0900) (free victoria slot_0930) (free victoria slot_1000) (free victoria slot_1030)
    (free victoria slot_1100) (free victoria slot_1130) (free victoria slot_1200) (free victoria slot_1230)
    (free victoria slot_1300)
    ;; 13:30 - 14:00 is slot_1330 (busy)
    (free victoria slot_1400)
    ;; 14:30 - 15:30 is slot_1430 and slot_1500 (busy)
    (free victoria slot_1530) (free victoria slot_1600)
    ;; 16:30 - 17:00 is slot_1630 (busy)

    ;; Nancy busy periods: 9:00-14:00 (slot_0900-1330), 14:30-15:30 (slot_1430-1500)
    ;; 9:00 - 14:00 are slot_0900, 0930, 1000, 1030, 1100, 1130, 1200, 1230, 1300, 1330 (busy)
    (free nancy slot_1400)
    ;; 14:30 - 15:30 are slot_1430 and slot_1500 (busy)
    (free nancy slot_1530) (free nancy slot_1600) (free nancy slot_1630)
  )
  (:goal (meeting_scheduled))
  (:metric minimize (total-cost))
)