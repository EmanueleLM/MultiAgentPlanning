(define (problem calendar_scheduling_example_48)
  (:domain calendar_scheduling_domain)
  (:objects
    janet rachel cynthia - person
    t0900 t0930 t1000 t1030 t1100 t1130 t1200 t1230 t1300 t1330 t1400 t1430 t1500 t1530 t1600 t1630 t1700 - time
  )
  (:init
    ;; Temporal sequence
    (next t0900 t0930)
    (next t0930 t1000)
    (next t1000 t1030)
    (next t1030 t1100)
    (next t1100 t1130)
    (next t1130 t1200)
    (next t1200 t1230)
    (next t1230 t1300)
    (next t1300 t1330)
    (next t1330 t1400)
    (next t1400 t1430)
    (next t1430 t1500)
    (next t1500 t1530)
    (next t1530 t1600)
    (next t1600 t1630)
    (next t1630 t1700)

    ;; Janet's availability (Busy: 09:30-10:30, 12:30-13:00, 14:00-14:30)
    (available janet t0900)
    ;; Janet busy at t0930 (9:30-10:00)
    ;; Janet busy at t1000 (10:00-10:30)
    (available janet t1030)
    (available janet t1100)
    (available janet t1130)
    (available janet t1200)
    ;; Janet busy at t1230 (12:30-13:00)
    (available janet t1300)
    (available janet t1330)
    ;; Janet busy at t1400 (14:00-14:30)
    (available janet t1430)
    (available janet t1500)
    (available janet t1530)
    (available janet t1600)
    (available janet t1630)

    ;; Rachel's availability (No meetings the whole day)
    (available rachel t0900)
    (available rachel t0930)
    (available rachel t1000)
    (available rachel t1030)
    (available rachel t1100)
    (available rachel t1130)
    (available rachel t1200)
    (available rachel t1230)
    (available rachel t1300)
    (available rachel t1330)
    (available rachel t1400)
    (available rachel t1430)
    (available rachel t1500)
    (available rachel t1530)
    (available rachel t1600)
    (available rachel t1630)

    ;; Cynthia's availability (Busy: 9:30-10:00, 11:00-11:30, 12:30-14:30, 16:00-17:00)
    (available cynthia t0900)
    ;; Cynthia busy at t0930 (9:30-10:00)
    (available cynthia t1000)
    (available cynthia t1030)
    ;; Cynthia busy at t1100 (11:00-11:30)
    (available cynthia t1130)
    (available cynthia t1200)
    ;; Cynthia busy at t1230, t1300, t1330, t1400 (12:30-14:30)
    (available cynthia t1430)
    (available cynthia t1500)
    (available cynthia t1530)
    ;; Cynthia busy at t1600, t1630 (16:00-17:00)

    ;; Preferred start times (rather not meet before 13:30)
    (preferred_start t1330)
    (preferred_start t1400)
    (preferred_start t1430)
    (preferred_start t1500)
    (preferred_start t1530)
    (preferred_start t1600)
  )
  (:goal (scheduled))
)