(define (domain trip_planning)
  (:requirements :strips :typing)
  (:types city day count)
  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (stay_count ?c - city ?n - count)
    (next_day ?d1 ?d2 - day)
    (next_count ?n1 ?n2 - count)
    (can_fly ?c1 ?c2 - city)
    (not_started)
  )

  ;; Action to choose the first city of the trip, consuming the first day.
  (:action arrive_first_city
    :parameters (?c - city ?d_now ?d_next - day ?n_old ?n_new - count)
    :precondition (and (not_started)
                       (current_day ?d_now)
                       (next_day ?d_now ?d_next)
                       (stay_count ?c ?n_old)
                       (next_count ?n_old ?n_new))
    :effect (and (not (not_started))
                 (at ?c)
                 (not (current_day ?d_now))
                 (current_day ?d_next)
                 (not (stay_count ?c ?n_old))
                 (stay_count ?c ?n_new))
  )

  ;; Spending a full day in the current city.
  (:action stay_full_day
    :parameters (?c - city ?d_now ?d_next - day ?n_old ?n_new - count)
    :precondition (and (at ?c)
                       (current_day ?d_now)
                       (next_day ?d_now ?d_next)
                       (stay_count ?c ?n_old)
                       (next_count ?n_old ?n_new))
    :effect (and (not (current_day ?d_now))
                 (current_day ?d_next)
                 (not (stay_count ?c ?n_old))
                 (stay_count ?c ?n_new))
  )

  ;; Traveling between cities. To reconcile the 15-day limit with 17 required stay-days,
  ;; the travel day counts as a stay day for both the origin and the destination city.
  (:action travel_day
    :parameters (?c_from ?c_to - city ?d_now ?d_next - day ?n_from_old ?n_from_new ?n_to_old ?n_to_new - count)
    :precondition (and (at ?c_from)
                       (can_fly ?c_from ?c_to)
                       (current_day ?d_now)
                       (next_day ?d_now ?d_next)
                       (stay_count ?c_from ?n_from_old)
                       (next_count ?n_from_old ?n_from_new)
                       (stay_count ?c_to ?n_to_old)
                       (next_count ?n_to_old ?n_to_new))
    :effect (and (not (at ?c_from))
                 (at ?c_to)
                 (not (current_day ?d_now))
                 (current_day ?d_next)
                 (not (stay_count ?c_from ?n_from_old))
                 (stay_count ?c_from ?n_from_new)
                 (not (stay_count ?c_to ?n_to_old))
                 (stay_count ?c_to ?n_to_new))
  )
)