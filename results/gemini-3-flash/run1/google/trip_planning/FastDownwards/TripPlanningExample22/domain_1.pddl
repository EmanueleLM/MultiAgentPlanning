(define (domain trip_planning)
    (:requirements :strips :typing)
    (:types city day count)
    (:predicates
      (at ?c - city)
      (day ?d - day)
      (next_day ?d1 - day ?d2 - day)
      (visit_count ?c - city ?n - count)
      (next_count ?n1 - count ?n2 - count)
      (has_flight ?c1 - city ?c2 - city)
      (visited ?c - city ?d - day)
    )

    (:action stay
      :parameters (?c - city ?d - day ?nd - day ?cc - count ?nc - count)
      :precondition (and (at ?c) (day ?d) (next_day ?d ?nd)
                         (visit_count ?c ?cc) (next_count ?cc ?nc))
      :effect (and (not (day ?d)) (day ?nd)
                   (not (visit_count ?c ?cc)) (visit_count ?c ?nc)
                   (visited ?c ?d))
    )

    (:action fly
      :parameters (?from - city ?to - city ?d - day ?nd - day ?cfc - count ?cfn - count ?ctc - count ?ctn - count)
      :precondition (and (at ?from) (day ?d) (next_day ?d ?nd)
                         (visit_count ?from ?cfc) (next_count ?cfc ?cfn)
                         (visit_count ?to ?ctc) (next_count ?ctc ?ctn)
                         (has_flight ?from ?to))
      :effect (and (not (at ?from)) (at ?to)
                   (not (day ?d)) (day ?nd)
                   (not (visit_count ?from ?cfc)) (visit_count ?from ?cfn)
                   (not (visit_count ?to ?ctc)) (visit_count ?to ?ctn)
                   (visited ?from ?d) (visited ?to ?d))
    )
  )