(define (problem trip_11_days)
    (:domain trip_planning)
    (:objects
      berlin frankfurt bucharest - city
      d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 d11 d12 - day
      c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 - count
    )
    (:init
      (at berlin)
      (day d1)
      (visit_count berlin c0)
      (visit_count frankfurt c0)
      (visit_count bucharest c0)
      (next_day d1 d2)
      (next_day d2 d3)
      (next_day d3 d4)
      (next_day d4 d5)
      (next_day d5 d6)
      (next_day d6 d7)
      (next_day d7 d8)
      (next_day d8 d9)
      (next_day d9 d10)
      (next_day d10 d11)
      (next_day d11 d12)
      (next_count c0 c1)
      (next_count c1 c2)
      (next_count c2 c3)
      (next_count c3 c4)
      (next_count c4 c5)
      (next_count c5 c6)
      (next_count c6 c7)
      (next_count c7 c8)
      (next_count c8 c9)
      (next_count c9 c10)
      (next_count c10 c11)
      (has_flight berlin frankfurt)
      (has_flight frankfurt berlin)
      (has_flight frankfurt bucharest)
      (has_flight bucharest frankfurt)
    )
    (:goal
      (and
        (day d12)
        (visit_count berlin c7)
        (visit_count frankfurt c4)
        (visit_count bucharest c2)
        (visited berlin d1)
        (visited berlin d2)
        (visited berlin d3)
        (visited berlin d4)
        (visited berlin d5)
        (visited berlin d6)
        (visited berlin d7)
      )
    )
  )