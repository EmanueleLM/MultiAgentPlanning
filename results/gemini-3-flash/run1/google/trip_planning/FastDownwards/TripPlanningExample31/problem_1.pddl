(define (problem trip_planning_example_31)
  (:domain trip_planning_31)
  (:objects
    frankfurt reykjavik split - city
    d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 - day
    n0 n1 n2 n3 n4 n5 n6 n7 n8 n9 n10 - num
  )
  (:init
    (not_started)
    (count frankfurt n0)
    (count reykjavik n0)
    (count split n0)
    (next_day d1 d2)
    (next_day d2 d3)
    (next_day d3 d4)
    (next_day d4 d5)
    (next_day d5 d6)
    (next_day d6 d7)
    (next_day d7 d8)
    (next_day d8 d9)
    (next_day d9 d10)
    (succ n0 n1)
    (succ n1 n2)
    (succ n2 n3)
    (succ n3 n4)
    (succ n4 n5)
    (succ n5 n6)
    (succ n6 n7)
    (succ n7 n8)
    (succ n8 n9)
    (succ n9 n10)
    (has_flight frankfurt reykjavik)
    (has_flight reykjavik frankfurt)
    (has_flight split frankfurt)
    (has_flight frankfurt split)
  )
  (:goal
    (and
      (count frankfurt n2)
      (count reykjavik n3)
      (count split n7)
      (visited reykjavik d8)
      (visited reykjavik d9)
      (visited reykjavik d10)
    )
  )
)