(define (problem trip_planning_35)
  (:domain trip_planning)
  (:objects
    bucharest zurich dubrovnik - city
    d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 - day
    c0 c1 c2 c3 c4 c5 c6 c7 - count_val
  )
  (:init
    (not_started)
    (is_start_day d1)
    (current_count bucharest c0)
    (current_count zurich c0)
    (current_count dubrovnik c0)
    (flight bucharest zurich)
    (flight zurich bucharest)
    (flight zurich dubrovnik)
    (flight dubrovnik zurich)
    (next_day d1 d2)
    (next_day d2 d3)
    (next_day d3 d4)
    (next_day d4 d5)
    (next_day d5 d6)
    (next_day d6 d7)
    (next_day d7 d8)
    (next_day d8 d9)
    (next_day d9 d10)
    (next_count c0 c1)
    (next_count c1 c2)
    (next_count c2 c3)
    (next_count c3 c4)
    (next_count c4 c5)
    (next_count c5 c6)
    (next_count c6 c7)
  )
  (:goal
    (and
      (current_count bucharest c3)
      (current_count zurich c2)
      (current_count dubrovnik c7)
      (visited dubrovnik d4)
      (visited dubrovnik d5)
      (visited dubrovnik d6)
      (visited dubrovnik d7)
      (visited dubrovnik d8)
      (visited dubrovnik d9)
      (visited dubrovnik d10)
    )
  )
)