(define (problem trip_example)
  (:domain trip_planning)
  (:objects
    stockholm athens mykonos - city
    d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 d11 d12 d13 - day
    n0 n1 n2 n3 n4 n5 n6 n7 n8 n9 n10 n11 n12 n13 - count
  )
  (:init
    (at stockholm)
    (day d1)
    (is_stockholm stockholm)
    (is_day_1 d1)
    (is_day_6 d6)
    (is_day_13 d13)
    
    (count stockholm n0)
    (count athens n0)
    (count mykonos n0)
    
    (next_day d1 d2)
    (next_day d2 d3)
    (next_day d3 d4)
    (next_day d4 d5)
    (next_day d5 d6)
    (next_day d6 d7)
    (next_day d7 d8)
    (next_day d8 d9)
    (next_day d9 d10)
    (next_day d10 d11)
    (next_day d11 d12)
    (next_day d12 d13)
    
    (next_count n0 n1)
    (next_count n1 n2)
    (next_count n2 n3)
    (next_count n3 n4)
    (next_count n4 n5)
    (next_count n5 n6)
    (next_count n6 n7)
    (next_count n7 n8)
    (next_count n8 n9)
    (next_count n9 n10)
    (next_count n10 n11)
    (next_count n11 n12)
    (next_count n12 n13)
    
    (flight stockholm athens)
    (flight athens stockholm)
    (flight athens mykonos)
    (flight mykonos athens)
  )
  (:goal (and
    (count stockholm n6)
    (count athens n5)
    (count mykonos n4)
    (trip_done)
  ))
)