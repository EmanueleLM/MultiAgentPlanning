(define (problem calendarschedulingexample22)
  (:domain calendar_scheduling)
  (:objects
    theresa charles betty - person
    t0900 t0930 t1000 t1030 t1100 t1130 t1200 t1230 t1300 t1330 t1400 t1430 t1500 t1530 t1600 t1630 t1700 - time_point
  )
  (:init
    ;; Time point ordering
    (next t0900 t0930)
    (next t0930 t1000)
    (next t1000 t1030)
    (next t1030 t1100)
    (next t1100 t1130)
    (next t1130 t1200)
    (next t1200 t1230)
    (next t1230 t1300)
    (next t1300 t1330)
    (next t1330 t1400)
    (next t1400 t1430)
    (next t1430 t1500)
    (next t1500 t1530)
    (next t1530 t1600)
    (next t1600 t1630)
    (next t1630 t1700)

    ;; Theresa availability (Busy: 9:00-9:30, 12:30-13:30, 14:00-15:00, 16:30-17:00)
    (available theresa t0930 t1000)
    (available theresa t1000 t1030)
    (available theresa t1030 t1100)
    (available theresa t1100 t1130)
    (available theresa t1130 t1200)
    (available theresa t1200 t1230)
    (available theresa t1330 t1400)
    (available theresa t1500 t1530)
    (available theresa t1530 t1600)
    (available theresa t1600 t1630)

    ;; Charles availability (Busy: 10:00-10:30, 11:30-12:30, 14:00-15:30)
    (available charles t0900 t0930)
    (available charles t0930 t1000)
    (available charles t1030 t1100)
    (available charles t1100 t1130)
    (available charles t1230 t1300)
    (available charles t1300 t1330)
    (available charles t1330 t1400)
    (available charles t1530 t1600)
    (available charles t1600 t1630)
    (available charles t1630 t1700)

    ;; Betty availability (Busy: 9:00-10:30, 12:00-12:30, 13:00-14:00, 15:00-16:00)
    (available betty t1030 t1100)
    (available betty t1100 t1130)
    (available betty t1130 t1200)
    (available betty t1230 t1300)
    (available betty t1400 t1430)
    (available betty t1430 t1500)
    (available betty t1600 t1630)
    (available betty t1630 t1700)
  )
  (:goal (meeting_scheduled))
)