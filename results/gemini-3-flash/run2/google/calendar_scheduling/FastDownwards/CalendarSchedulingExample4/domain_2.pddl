(define (domain calendar_scheduling)
  (:requirements :strips :typing)
  (:types person slot)
  (:constants donna john billy - person)
  (:predicates
    (available ?p - person ?s - slot)
    (meeting_scheduled)
  )
  (:action schedule_meeting
    :parameters (?s - slot)
    :precondition (and (available donna ?s)
                       (available john ?s)
                       (available billy ?s))
    :effect (meeting_scheduled)
  )
)