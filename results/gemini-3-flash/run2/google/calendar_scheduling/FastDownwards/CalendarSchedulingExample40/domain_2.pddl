(define (domain calendar_scheduling)
  (:requirements :strips :typing)
  (:types person time)
  (:predicates
    (available ?p - person ?t - time)
    (next ?t1 ?t2 - time)
    (is_jacob ?p - person)
    (is_gabriel ?p - person)
    (is_matthew ?p - person)
    (meeting_scheduled)
  )
  (:action schedule_1h_meeting
    :parameters (?p1 ?p2 ?p3 - person ?t_start ?t_mid ?t_end - time)
    :precondition (and
      (is_jacob ?p1)
      (is_gabriel ?p2)
      (is_matthew ?p3)
      (next ?t_start ?t_mid)
      (next ?t_mid ?t_end)
      (available ?p1 ?t_start)
      (available ?p1 ?t_mid)
      (available ?p2 ?t_start)
      (available ?p2 ?t_mid)
      (available ?p3 ?t_start)
      (available ?p3 ?t_mid)
    )
    :effect (meeting_scheduled)
  )
)