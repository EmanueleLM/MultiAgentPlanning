(define (problem calendar_example_43)
  (:domain calendar_scheduling)
  (:objects
    t0900 t0930 t1000 t1030 t1100 t1130 t1200 t1230
    t1300 t1330 t1400 t1430 t1500 t1530 t1600 t1630 - time_slot
  )
  (:init
    ;; Starting time
    (at_time t0900)

    ;; Chronological order of time slots
    (next t0900 t0930)
    (next t0930 t1000)
    (next t1000 t1030)
    (next t1030 t1100)
    (next t1100 t1130)
    (next t1130 t1200)
    (next t1200 t1230)
    (next t1230 t1300)
    (next t1300 t1330)
    (next t1330 t1400)
    (next t1400 t1430)
    (next t1430 t1500)
    (next t1500 t1530)
    (next t1530 t1600)
    (next t1600 t1630)

    ;; Albert's free slots (derived from busy: 9:30-10:30, 12:00, 14:00, 15:00, 16:30)
    (free_albert t0900)
    (free_albert t1030)
    (free_albert t1100)
    (free_albert t1130)
    (free_albert t1230)
    (free_albert t1300)
    (free_albert t1330)
    (free_albert t1430)
    (free_albert t1530)
    (free_albert t1600)

    ;; Gregory's free slots (derived from busy: 11:00, 12:30, 13:30, 15:30)
    (free_gregory t0900)
    (free_gregory t0930)
    (free_gregory t1000)
    (free_gregory t1030)
    (free_gregory t1130)
    (free_gregory t1200)
    (free_gregory t1300)
    (free_gregory t1400)
    (free_gregory t1430)
    (free_gregory t1500)
    (free_gregory t1600)
    (free_gregory t1630)

    ;; Benjamin's free slots (derived from busy: 9:30, 10:30, 11:30-13:30, 14:00-15:00, 15:30, 16:30)
    (free_benjamin t0900)
    (free_benjamin t1000)
    (free_benjamin t1100)
    (free_benjamin t1330)
    (free_benjamin t1500)
    (free_benjamin t1600)
  )
  (:goal (meeting_scheduled))
)