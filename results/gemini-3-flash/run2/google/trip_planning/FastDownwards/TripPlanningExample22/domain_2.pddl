(define (domain trip_planning)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day count)
  (:predicates
    (at_city ?c - city ?d - day)
    (curr_city ?c - city)
    (curr_day ?d - day)
    (next_day ?d1 ?d2 - day)
    (conn ?c1 ?c2 - city)
    (visit_count ?c - city ?n - count)
    (next_val ?n1 ?n2 - count)
  )

  (:action stay
    :parameters (?c - city ?d_curr ?d_next - day ?n_curr ?n_next - count)
    :precondition (and 
      (curr_city ?c) 
      (curr_day ?d_curr) 
      (next_day ?d_curr ?d_next)
      (visit_count ?c ?n_curr) 
      (next_val ?n_curr ?n_next)
    )
    :effect (and 
      (not (curr_day ?d_curr)) 
      (curr_day ?d_next)
      (at_city ?c ?d_curr)
      (not (visit_count ?c ?n_curr)) 
      (visit_count ?c ?n_next)
    )
  )

  (:action fly
    :parameters (?from ?to - city ?d_curr ?d_next - day ?nf_curr ?nf_next ?nt_curr ?nt_next - count)
    :precondition (and 
      (curr_city ?from) 
      (curr_day ?d_curr) 
      (next_day ?d_curr ?d_next)
      (conn ?from ?to)
      (visit_count ?from ?nf_curr) 
      (next_val ?nf_curr ?nf_next)
      (visit_count ?to ?nt_curr) 
      (next_val ?nt_curr ?nt_next)
    )
    :effect (and 
      (not (curr_city ?from)) 
      (curr_city ?to)
      (not (curr_day ?d_curr)) 
      (curr_day ?d_next)
      (at_city ?from ?d_curr)
      (at_city ?to ?d_curr)
      (not (visit_count ?from ?nf_curr)) 
      (visit_count ?from ?nf_next)
      (not (visit_count ?to ?nt_curr)) 
      (visit_count ?to ?nt_next)
    )
  )
)