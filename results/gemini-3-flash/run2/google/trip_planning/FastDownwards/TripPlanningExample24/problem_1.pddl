    (:init
        (at_city florence)
        (day_now d1)
        (stay_count florence c0)
        (stay_count amsterdam c0)
        (stay_count riga c0)

        (connected florence amsterdam)
        (connected amsterdam florence)
        (connected amsterdam riga)
