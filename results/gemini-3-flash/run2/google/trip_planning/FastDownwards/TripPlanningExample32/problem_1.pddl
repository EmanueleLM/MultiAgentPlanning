(define (problem trip_planning_problem)
  (:domain trip_planning)
  (:objects
    d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 d11 - day
    n0 n1 n2 n3 n4 n5 - count_num
  )
  (:init
    (current_day d1)
    (at_riga)
    (riga_count n0)
    (paris_count n0)
    (reykjavik_count n0)
    (next_day d1 d2)
    (next_day d2 d3)
    (next_day d3 d4)
    (next_day d4 d5)
    (next_day d5 d6)
    (next_day d6 d7)
    (next_day d7 d8)
    (next_day d8 d9)
    (next_day d9 d10)
    (next_day d10 d11)
    (next_riga n0 n1)
    (next_riga n1 n2)
    (next_riga n2 n3)
    (next_riga n3 n3)
    (next_paris n0 n1)
    (next_paris n1 n2)
    (next_paris n2 n3)
    (next_paris n3 n4)
    (next_paris n4 n4)
    (next_reykjavik n0 n1)
    (next_reykjavik n1 n2)
    (next_reykjavik n2 n3)
    (next_reykjavik n3 n4)
    (next_reykjavik n4 n5)
    (next_reykjavik n5 n5)
  )
  (:goal
    (and
      (current_day d11)
      (riga_count n3)
      (paris_count n4)
      (reykjavik_count n5)
      (visited_reykjavik d6)
      (visited_reykjavik d7)
      (visited_reykjavik d8)
      (visited_reykjavik d9)
      (visited_reykjavik d10)
    )
  )
)