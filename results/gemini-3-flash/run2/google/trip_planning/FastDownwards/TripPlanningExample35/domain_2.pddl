(define (domain trip_planning)
  (:requirements :strips :typing)
  (:types city day count)
  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (next_day ?d1 ?d2 - day)
    (stay_count ?c - city ?n - count)
    (next_count ?n1 ?n2 - count)
    (is_at_day ?c - city ?d - day)
    (connected ?c1 ?c2 - city)
  )

  (:action stay
    :parameters (?c - city ?d - day ?dn - day ?n - count ?nn - count)
    :precondition (and
      (at ?c)
      (current_day ?d)
      (next_day ?d ?dn)
      (stay_count ?c ?n)
      (next_count ?n ?nn)
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?dn)
      (is_at_day ?c ?d)
      (not (stay_count ?c ?n))
      (stay_count ?c ?nn)
    )
  )

  (:action fly
    :parameters (?c1 - city ?c2 - city ?d - day ?dn - day ?n1 - count ?nn1 - count ?n2 - count ?nn2 - count)
    :precondition (and
      (at ?c1)
      (connected ?c1 ?c2)
      (current_day ?d)
      (next_day ?d ?dn)
      (stay_count ?c1 ?n1)
      (next_count ?n1 ?nn1)
      (stay_count ?c2 ?n2)
      (next_count ?n2 ?nn2)
    )
    :effect (and
      (not (at ?c1))
      (at ?c2)
      (not (current_day ?d))
      (current_day ?dn)
      (is_at_day ?c1 ?d)
      (is_at_day ?c2 ?d)
      (not (stay_count ?c1 ?n1))
      (stay_count ?c1 ?nn1)
      (not (stay_count ?c2 ?n2))
      (stay_count ?c2 ?nn2)
    )
  )
)