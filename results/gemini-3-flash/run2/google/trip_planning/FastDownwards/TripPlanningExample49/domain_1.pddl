(define (domain trip_planning)
  (:requirements :strips :typing)
  (:types city day count)
  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (next_day ?d1 ?d2 - day)
    (count_at ?c - city ?q - count)
    (next_count ?q1 ?q2 - count)
    (visited_at ?c - city ?d - day)
    (can_fly ?c1 ?c2 - city)
    (trip_complete)
  )

  (:action stay
    :parameters (?city - city ?d - day ?nd - day ?q - count ?nq - count)
    :precondition (and
      (at ?city)
      (current_day ?d)
      (next_day ?d ?nd)
      (count_at ?city ?q)
      (next_count ?q ?nq)
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?nd)
      (not (count_at ?city ?q))
      (count_at ?city ?nq)
      (visited_at ?city ?d)
    )
  )

  (:action fly
    :parameters (?from - city ?to - city ?d - day ?nd - day ?qf - count ?nqf - count ?qt - count ?nqt - count)
    :precondition (and
      (at ?from)
      (can_fly ?from ?to)
      (current_day ?d)
      (next_day ?d ?nd)
      (count_at ?from ?qf)
      (next_count ?qf ?nqf)
      (count_at ?to ?qt)
      (next_count ?qt ?nqt)
    )
    :effect (and
      (not (at ?from))
      (at ?to)
      (not (current_day ?d))
      (current_day ?nd)
      (not (count_at ?from ?qf))
      (count_at ?from ?nqf)
      (not (count_at ?to ?qt))
      (count_at ?to ?nqt)
      (visited_at ?from ?d)
      (visited_at ?to ?d)
    )
  )

  (:action complete_trip
    :parameters (?city - city ?d - day ?q - count ?nq - count)
    :precondition (and
      (at ?city)
      (current_day ?d)
      (count_at ?city ?q)
      (next_count ?q ?nq)
    )
    :effect (and
      (not (count_at ?city ?q))
      (count_at ?city ?nq)
      (visited_at ?city ?d)
      (trip_complete)
    )
  )
)