(define (domain trip_planning)
  (:requirements :strips :typing)
  (:types city day count)
  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (next_day ?d1 ?d2 - day)
    (visited ?c - city ?d - day)
    (count_visited ?c - city ?n - count)
    (next_count ?n1 ?n2 - count)
    (can_fly ?c1 ?c2 - city)
  )

  (:action spend_day_and_stay
    :parameters (?c - city ?d - day ?nd - day ?q - count ?nq - count)
    :precondition (and
      (at ?c)
      (current_day ?d)
      (next_day ?d ?nd)
      (count_visited ?c ?q)
      (next_count ?q ?nq)
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?nd)
      (visited ?c ?d)
      (not (count_visited ?c ?q))
      (count_visited ?c ?nq)
    )
  )

  (:action spend_day_and_fly
    :parameters (?from - city ?to - city ?d - day ?nd - day ?qf - count ?nqf - count ?qt - count ?nqt - count)
    :precondition (and
      (at ?from)
      (can_fly ?from ?to)
      (current_day ?d)
      (next_day ?d ?nd)
      (count_visited ?from ?qf)
      (next_count ?qf ?nqf)
      (count_visited ?to ?qt)
      (next_count ?qt ?nqt)
    )
    :effect (and
      (not (at ?from))
      (at ?to)
      (not (current_day ?d))
      (current_day ?nd)
      (visited ?from ?d)
      (visited ?to ?d)
      (not (count_visited ?from ?qf))
      (count_visited ?from ?nqf)
      (not (count_visited ?to ?qt))
      (count_visited ?to ?nqt)
    )
  )
)