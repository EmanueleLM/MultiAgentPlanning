    (next s1430 s1500)
    (next s1500 s1530)
    (next s1530 s1600)
    (next s1600 s1630)

    ;; Billy's availability
    ;; Busy: 11:30-12:00 (s1130), 13:00-15:00 (s1300, s1330, s1400, s1430), 16:00-16:30 (s1600)
    (free billy s0900)
    (free billy s0930)
    (free billy s1000)
    (free billy s1030)
    (free billy s1100)
    (free billy s1200)
    (free billy s1230)
    (free billy s1500)
    (free billy s1530)
    (free billy s1630)

