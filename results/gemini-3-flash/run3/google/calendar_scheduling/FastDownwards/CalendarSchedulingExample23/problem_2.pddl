    (free maria s1030)
    (free maria s1100)
    (free maria s1130)
    (free maria s1200)
    (free maria s1230)
    (free maria s1330)
    (free maria s1430)
    (free maria s1500)
    (free maria s1530)
    (free maria s1600)
    (free maria s1630)

    ;; William's availability
    ;; Busy: 9:30-10:00 (s0930), 12:00-12:30 (s1200), 13:30-15:00 (s1330, s1400, s1430), 15:30-17:00 (s1530, s1600, s1630)
    (free william s0900)
    (free william s1000)
    (free william s1030)
    (free william s1100)
    (free william s1130)
    (free william s1230)
    (free william s1300)
    (free william s1500)
  )
  (:goal (and
    (meeting_scheduled)
  ))
