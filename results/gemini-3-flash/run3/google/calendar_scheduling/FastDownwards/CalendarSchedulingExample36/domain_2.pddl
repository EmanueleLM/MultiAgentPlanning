(define (domain calendar_scheduling)
  (:requirements :strips :typing)
  (:types time)
  (:predicates
    (ryan_free ?t - time)
    (ruth_free ?t - time)
    (denise_free ?t - time)
    (denise_willing ?t - time)
    (next ?t1 ?t2 - time)
    (scheduled)
  )

  (:action schedule_1h_meeting
    :parameters (?t_start ?t_mid ?t_end - time)
    :precondition (and
      (next ?t_start ?t_mid)
      (next ?t_mid ?t_end)
      (ryan_free ?t_start)
      (ryan_free ?t_mid)
      (ruth_free ?t_start)
      (ruth_free ?t_mid)
      (denise_free ?t_start)
      (denise_free ?t_mid)
      (denise_willing ?t_start)
      (denise_willing ?t_mid)
    )
    :effect (scheduled)
  )
)