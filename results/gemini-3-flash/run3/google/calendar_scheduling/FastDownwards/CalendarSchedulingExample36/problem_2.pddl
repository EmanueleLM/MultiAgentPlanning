(define (problem calendarschedulingexample36)
  (:domain calendar_scheduling)
  (:objects
    t0900 t0930 t1000 t1030 t1100 t1130 t1200 t1230 t1300 t1330 t1400 t1430 t1500 t1530 t1600 t1630 t1700 - time
  )
  (:init
    ;; Time sequencing (30-minute intervals from 09:00 to 17:00)
    (next t0900 t0930)
    (next t0930 t1000)
    (next t1000 t1030)
    (next t1030 t1100)
    (next t1100 t1130)
    (next t1130 t1200)
    (next t1200 t1230)
    (next t1230 t1300)
    (next t1300 t1330)
    (next t1330 t1400)
    (next t1400 t1430)
    (next t1430 t1500)
    (next t1500 t1530)
    (next t1530 t1600)
    (next t1600 t1630)
    (next t1630 t1700)

    ;; Ryan's availability
    ;; Busy 9:00-9:30 (t0900), 12:30-13:00 (t1230)
    (ryan_free t0930)
    (ryan_free t1000)
    (ryan_free t1030)
    (ryan_free t1100)
    (ryan_free t1130)
    (ryan_free t1200)
    (ryan_free t1300)
    (ryan_free t1330)
    (ryan_free t1400)
    (ryan_free t1430)
    (ryan_free t1500)
    (ryan_free t1530)
    (ryan_free t1600)
    (ryan_free t1630)

    ;; Ruth's availability
    ;; Free all day (9:00 to 17:00)
    (ruth_free t0900)
    (ruth_free t0930)
    (ruth_free t1000)
    (ruth_free t1030)
    (ruth_free t1100)
    (ruth_free t1130)
    (ruth_free t1200)
    (ruth_free t1230)
    (ruth_free t1300)
    (ruth_free t1330)
    (ruth_free t1400)
    (ruth_free t1430)
    (ruth_free t1500)
    (ruth_free t1530)
    (ruth_free t1600)
    (ruth_free t1630)

    ;; Denise's availability
    ;; Busy 9:30-10:30 (t0930, t1000), 12:00-13:00 (t1200, t1230), 14:30-16:30 (t1430, t1500, t1530, t1600)
    (denise_free t0900)
    (denise_free t1030)
    (denise_free t1100)
    (denise_free t1130)
    (denise_free t1300)
    (denise_free t1330)
    (denise_free t1400)
    (denise_free t1630)

    ;; Denise's constraints (Hard preference: no meeting after 12:30)
    ;; This means any 30-min block used must end by 12:30
    (denise_willing t0900)
    (denise_willing t0930)
    (denise_willing t1000)
    (denise_willing t1030)
    (denise_willing t1100)
    (denise_willing t1130)
    (denise_willing t1200)
  )
  (:goal
    (scheduled)
  )
)