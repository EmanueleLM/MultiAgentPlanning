(define (domain calendar_scheduling)
  (:requirements :strips :typing)
  (:types time person)
  (:predicates
    (next ?t1 ?t2 - time)
    (free ?p - person ?t1 ?t2 - time)
    (is_preferred ?t - time)
    (meeting_scheduled)
  )
  (:action schedule_meeting
    :parameters (?t1 - time ?t2 - time ?t3 - time)
    :precondition (and
      (next ?t1 ?t2)
      (next ?t2 ?t3)
      (is_preferred ?t1)
      (free janet ?t1 ?t2)
      (free janet ?t2 ?t3)
      (free rachel ?t1 ?t2)
      (free rachel ?t2 ?t3)
      (free cynthia ?t1 ?t2)
      (free cynthia ?t2 ?t3)
    )
    :effect (meeting_scheduled)
  )
)