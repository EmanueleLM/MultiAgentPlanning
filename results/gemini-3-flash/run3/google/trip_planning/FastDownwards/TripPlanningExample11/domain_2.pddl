(define (domain trip_planning)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day count)
  (:predicates
    (at_city ?c - city)
    (current_day ?d - day)
    (count ?c - city ?n - count)
    (visited_at ?c - city ?d - day)
    (next_day ?d1 ?d2 - day)
    (next_count ?n1 ?n2 - count)
    (can_fly ?c1 ?c2 - city)
    (started)
    (is_day_1 ?d - day)
    (is_count_1 ?n - count)
    (is_count_0 ?n - count)
  )

  (:action start
    :parameters (?c - city ?d1 - day ?n1 - count ?n0 - count)
    :precondition (and 
      (not (started))
      (is_day_1 ?d1)
      (is_count_1 ?n1)
      (is_count_0 ?n0)
      (count ?c ?n0)
    )
    :effect (and
      (started)
      (at_city ?c)
      (current_day ?d1)
      (not (count ?c ?n0))
      (count ?c ?n1)
      (visited_at ?c ?d1)
    )
  )

  (:action stay
    :parameters (?c - city ?d_curr ?d_next - day ?n_curr ?n_next - count)
    :precondition (and
      (started)
      (at_city ?c)
      (current_day ?d_curr)
      (next_day ?d_curr ?d_next)
      (count ?c ?n_curr)
      (next_count ?n_curr ?n_next)
    )
    :effect (and
      (not (current_day ?d_curr))
      (current_day ?d_next)
      (not (count ?c ?n_curr))
      (count ?c ?n_next)
      (visited_at ?c ?d_next)
    )
  )

  (:action fly
    :parameters (?from ?to - city ?d_curr ?d_next - day ?n_curr ?n_next - count)
    :precondition (and
      (started)
      (at_city ?from)
      (can_fly ?from ?to)
      (current_day ?d_curr)
      (next_day ?d_curr ?d_next)
      (count ?to ?n_curr)
      (next_count ?n_curr ?n_next)
    )
    :effect (and
      (not (at_city ?from))
      (at_city ?to)
      (not (current_day ?d_curr))
      (current_day ?d_next)
      (not (count ?to ?n_curr))
      (count ?to ?n_next)
      (visited_at ?to ?d_next)
    )
  )
)