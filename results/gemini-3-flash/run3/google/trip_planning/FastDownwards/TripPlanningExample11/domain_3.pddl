(define (domain trip_planning)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day count)
  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (city_count ?c - city ?n - count)
    (day_at ?c - city ?d - day)
    (next_day ?d1 ?d2 - day)
    (next_count ?n1 ?n2 - count)
    (can_fly ?c1 ?c2 - city)
    (started)
    (is_day_1 ?d - day)
  )

  (:action arrive
    :parameters (?c - city ?d1 - day ?n0 ?n1 - count)
    :precondition (and
      (not (started))
      (is_day_1 ?d1)
      (next_count ?n0 ?n1)
      (city_count ?c ?n0)
    )
    :effect (and
      (started)
      (at ?c)
      (current_day ?d1)
      (not (city_count ?c ?n0))
      (city_count ?c ?n1)
      (day_at ?c ?d1)
    )
  )

  (:action stay
    :parameters (?c - city ?d_curr ?d_next - day ?n_curr ?n_next - count)
    :precondition (and
      (started)
      (at ?c)
      (current_day ?d_curr)
      (next_day ?d_curr ?d_next)
      (city_count ?c ?n_curr)
      (next_count ?n_curr ?n_next)
    )
    :effect (and
      (not (current_day ?d_curr))
      (current_day ?d_next)
      (not (city_count ?c ?n_curr))
      (city_count ?c ?n_next)
      (day_at ?c ?d_next)
    )
  )

  (:action fly
    :parameters (?from ?to - city ?d_curr ?d_next - day ?n_curr_to ?n_next_to - count)
    :precondition (and
      (started)
      (at ?from)
      (can_fly ?from ?to)
      (current_day ?d_curr)
      (next_day ?d_curr ?d_next)
      (city_count ?to ?n_curr_to)
      (next_count ?n_curr_to ?n_next_to)
    )
    :effect (and
      (not (at ?from))
      (at ?to)
      (not (current_day ?d_curr))
      (current_day ?d_next)
      (not (city_count ?to ?n_curr_to))
      (city_count ?to ?n_next_to)
      (day_at ?to ?d_next)
    )
  )
)