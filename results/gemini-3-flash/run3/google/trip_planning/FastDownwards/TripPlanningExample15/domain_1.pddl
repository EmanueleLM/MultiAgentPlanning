(define (domain trip_planning_example15)
  (:requirements :strips :typing)
  (:types city day val)
  (:predicates
    (at ?c - city ?d - day)
    (count ?c - city ?v - val)
    (current_day ?d - day)
    (next_day ?d1 ?d2 - day)
    (next_val ?v1 ?v2 - val)
    (connected ?c1 ?c2 - city)
    (trip_started)
    (is_d1 ?d - day)
  )

  ;; Action to start the trip on day 1
  (:action start_trip
    :parameters (?c - city ?d1 - day ?v0 ?v1 - val)
    :precondition (and (not (trip_started))
                       (is_d1 ?d1)
                       (count ?c ?v0)
                       (next_val ?v0 ?v1))
    :effect (and (trip_started)
                 (at ?c ?d1)
                 (current_day ?d1)
                 (not (count ?c ?v0))
                 (count ?c ?v1))
  )

  ;; Action to stay in the same city for another day
  (:action stay
    :parameters (?c - city ?d_prev ?d_next - day ?v_old ?v_new - val)
    :precondition (and (trip_started)
                       (current_day ?d_prev)
                       (next_day ?d_prev ?d_next)
                       (at ?c ?d_prev)
                       (count ?c ?v_old)
                       (next_val ?v_old ?v_new))
    :effect (and (not (current_day ?d_prev))
                 (current_day ?d_next)
                 (at ?c ?d_next)
                 (not (count ?c ?v_old))
                 (count ?c ?v_new))
  )

  ;; Action to fly to a new city and spend the day there
  (:action fly
    :parameters (?c_from ?c_to - city ?d_prev ?d_next - day ?v_old_to ?v_new_to - val)
    :precondition (and (trip_started)
                       (current_day ?d_prev)
                       (next_day ?d_prev ?d_next)
                       (at ?c_from ?d_prev)
                       (connected ?c_from ?c_to)
                       (count ?c_to ?v_old_to)
                       (next_val ?v_old_to ?v_new_to))
    :effect (and (not (current_day ?d_prev))
                 (current_day ?d_next)
                 (at ?c_to ?d_next)
                 (not (count ?c_to ?v_old_to))
                 (count ?c_to ?v_new_to))
  )
)