(define (problem trip_planning_problem)
  (:domain trip_planning)
  (:objects
    venice vienna mykonos - city
    d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 - day
    n0 n1 n2 n3 n4 n5 n6 n7 n8 n9 n10 - count
  )
  (:init
    (is_day_one d1)
    (next_day d1 d2)
    (next_day d2 d3)
    (next_day d3 d4)
    (next_day d4 d5)
    (next_day d5 d6)
    (next_day d6 d7)
    (next_day d7 d8)
    (next_day d8 d9)
    (next_day d9 d10)
    (next_count n0 n1)
    (next_count n1 n2)
    (next_count n2 n3)
    (next_count n3 n4)
    (next_count n4 n5)
    (next_count n5 n6)
    (next_count n6 n7)
    (next_count n7 n8)
    (next_count n8 n9)
    (next_count n9 n10)
    (flight mykonos vienna)
    (flight vienna mykonos)
    (flight vienna venice)
    (flight venice vienna)
    (total_stay venice n0)
    (total_stay vienna n0)
    (total_stay mykonos n0)
  )
  (:goal
    (and
      (at_day venice d5)
      (at_day venice d6)
      (at_day venice d7)
      (at_day venice d8)
      (at_day venice d9)
      (at_day venice d10)
      (total_stay venice n6)
      (total_stay vienna n4)
      (total_stay mykonos n2)
      (current_day d10)
    )
  )
)