(define (domain trip_planning_example_25)
        (:requirements :strips :typing)
        (:types city day count)
        (:predicates
            (at ?c - city)
            (current_day ?d - day)
            (city_count ?c - city ?n - count)
            (visited ?c - city ?d - day)
            (next_day ?d1 ?d2 - day)
            (next_count ?n1 ?n2 - count)
            (has_flight ?c1 ?c2 - city)
        )

        (:action stay
            :parameters (?c - city ?d - day ?dn - day ?i - count ?i1 - count)
            :precondition (and 
                (at ?c) 
                (current_day ?d) 
                (next_day ?d ?dn) 
                (city_count ?c ?i) 
                (next_count ?i ?i1)
            )
            :effect (and 
                (not (current_day ?d)) 
                (current_day ?dn) 
                (not (city_count ?c ?i)) 
                (city_count ?c ?i1) 
                (visited ?c ?d)
            )
        )

        (:action fly
            :parameters (?c1 - city ?c2 - city ?d - day ?dn - day ?i - count ?i1 - count ?j - count ?j1 - count)
            :precondition (and 
                (at ?c1) 
                (current_day ?d) 
                (next_day ?d ?dn) 
                (has_flight ?c1 ?c2) 
                (city_count ?c1 ?i) 
                (next_count ?i ?i1) 
                (city_count ?c2 ?j) 
                (next_count ?j ?j1)
            )
            :effect (and 
                (not (at ?c1)) 
                (at ?c2) 
                (not (current_day ?d)) 
                (current_day ?dn) 
                (not (city_count ?c1 ?i)) 
                (city_count ?c1 ?i1) 
                (not (city_count ?c2 ?j)) 
                (city_count ?c2 ?j1) 
                (visited ?c1 ?d) 
                (visited ?c2 ?d)
            )
        )
    )