(define (problem trip_planning_problem)
  (:domain trip_planning)
  (:objects
    reykjavik milan porto - city
    d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 - day
    n0 n1 n2 n3 n4 n5 n6 n7 n8 n9 n10 - count
  )
  (:init
    (not_started)
    (count_at reykjavik n0)
    (count_at milan n0)
    (count_at porto n0)
    (next_day d1 d2)
    (next_day d2 d3)
    (next_day d3 d4)
    (next_day d4 d5)
    (next_day d5 d6)
    (next_day d6 d7)
    (next_day d7 d8)
    (next_day d8 d9)
    (next_day d9 d10)
    (next_val n0 n1)
    (next_val n1 n2)
    (next_val n2 n3)
    (next_val n3 n4)
    (next_val n4 n5)
    (next_val n5 n6)
    (next_val n6 n7)
    (next_val n7 n8)
    (next_val n8 n9)
    (next_val n9 n10)
    (flight reykjavik milan)
    (flight milan reykjavik)
    (flight milan porto)
    (flight porto milan)
  )
  (:goal
    (and
      (at porto d9)
      (at porto d10)
      (count_at reykjavik n6)
      (count_at milan n4)
      (count_at porto n2)
    )
  )
)