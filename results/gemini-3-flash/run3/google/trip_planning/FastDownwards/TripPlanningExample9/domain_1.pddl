(define (domain trip_planning_example_9)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day count)
  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (stay_count ?c - city ?count - count)
    (next_day ?d1 - day ?d2 - day)
    (next_count ?c1 - count ?c2 - count)
    (connected ?c1 - city ?c2 - city)
    (visited_on ?c - city ?d - day)
  )

  (:action stay
    :parameters (?c - city ?d - day ?nd - day ?co - count ?cn - count)
    :precondition (and 
      (at ?c) 
      (current_day ?d) 
      (next_day ?d ?nd) 
      (stay_count ?c ?co) 
      (next_count ?co ?cn)
    )
    :effect (and 
      (not (current_day ?d)) 
      (current_day ?nd) 
      (not (stay_count ?c ?co)) 
      (stay_count ?c ?cn) 
      (visited_on ?c ?d)
    )
  )

  (:action travel
    :parameters (?from - city ?to - city ?d - day ?nd - day ?c1o - count ?c1n - count ?c2o - count ?c2n - count)
    :precondition (and 
      (at ?from) 
      (connected ?from ?to) 
      (current_day ?d) 
      (next_day ?d ?nd) 
      (stay_count ?from ?c1o) 
      (next_count ?c1o ?c1n) 
      (stay_count ?to ?c2o) 
      (next_count ?c2o ?c2n)
    )
    :effect (and 
      (not (at ?from)) 
      (at ?to) 
      (not (current_day ?d)) 
      (current_day ?nd) 
      (not (stay_count ?from ?c1o)) 
      (stay_count ?from ?c1n) 
      (not (stay_count ?to ?c2o)) 
      (stay_count ?to ?c2n) 
      (visited_on ?from ?d) 
      (visited_on ?to ?d)
    )
  )
)