(define (domain floor-tile)
  (:requirements :strips :typing :action-costs)
  (:types robot tile color - object)
  (:predicates 
    (robot-at ?r - robot ?t - tile)
    (robot-has ?r - robot ?c - color)
    (clear ?t - tile)
    (painted ?t - tile ?c - color)
    (available-color ?c - color)
    (up ?source - tile ?dest - tile)
    (down ?source - tile ?dest - tile)
    (right ?source - tile ?dest - tile)
    (left ?source - tile ?dest - tile)
  )
  (:functions (total-cost))
  (:action change-color
    :parameters (?r - robot ?c - color ?c2 - color)
    :precondition (and (robot-at ?r ?t) (robot-has ?r ?c) (available-color ?c2))
    :effect (and (not (robot-has ?r ?c)) (robot-has ?r ?c2) (increase (total-cost) 5))
  )
  (:action paint-up
    :parameters (?r - robot ?curr - tile ?above - tile ?c - color)
    :precondition (and (robot-at ?r ?curr) (robot-has ?r ?c) (clear ?above) (up ?above ?curr))
    :effect (and (not (clear ?above)) (painted ?above ?c) (increase (total-cost) 2))
  )
  (:action paint-down
    :parameters (?r - robot ?curr - tile ?below - tile ?c - color)
    :precondition (and (robot-at ?r ?curr) (robot-has ?r ?c) (clear ?below) (down ?below ?curr))
    :effect (and (not (clear ?below)) (painted ?below ?c) (increase (total-cost) 2))
  )
  (:action up
    :parameters (?r - robot ?curr - tile ?above - tile)
    :precondition (and (robot-at ?r ?curr) (clear ?above) (up ?above ?curr))
    :effect (and (not (robot-at ?r ?curr)) (robot-at ?r ?above) (clear ?curr) (not (clear ?above)) (increase (total-cost) 3))
  )
  (:action down
    :parameters (?r - robot ?curr - tile ?below - tile)
    :precondition (and (robot-at ?r ?curr) (clear ?below) (down ?below ?curr))
    :effect (and (not (robot-at ?r ?curr)) (robot-at ?r ?below) (clear ?curr) (not (clear ?below)) (increase (total-cost) 1))
  )
  (:action right
    :parameters (?r - robot ?curr - tile ?right - tile)
    :precondition (and (robot-at ?r ?curr) (clear ?right) (right ?right ?curr))
    :effect (and (not (robot-at ?r ?curr)) (robot-at ?r ?right) (clear ?curr) (not (clear ?right)) (increase (total-cost) 1))
  )
  (:action left
    :parameters (?r - robot ?curr - tile ?left - tile)
    :precondition (and (robot-at ?r ?curr) (clear ?left) (left ?left ?curr))
    :effect (and (not (robot-at ?r ?curr)) (robot-at ?r ?left) (clear ?curr) (not (clear ?left)) (increase (total-cost) 1))
  )
)