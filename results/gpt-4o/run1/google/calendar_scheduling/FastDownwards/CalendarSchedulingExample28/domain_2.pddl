(define (domain meeting_scheduling)
  (:requirements :strips :typing :negative-preconditions)
  (:types participant time_slot)
  (:predicates
    (busy ?p - participant ?s - time_slot)
    (available ?p - participant ?s - time_slot)
    (scheduled ?p1 - time_slot ?p2 - time_slot)
    (next ?s1 - time_slot ?s2 - time_slot)
    (all_available ?s1 - time_slot ?s2 - time_slot)
  )
  (:action CheckAvailability
    :parameters (?s1 - time_slot ?s2 - time_slot)
    :precondition (and
      (next ?s1 ?s2)
      (available brittany ?s1)
      (available brittany ?s2)
      (available emily ?s1)
      (available emily ?s2)
      (available doris ?s1)
      (available doris ?s2)
    )
    :effect (all_available ?s1 ?s2)
  )
  (:action ScheduleMeeting
    :parameters (?s1 - time_slot ?s2 - time_slot)
    :precondition (all_available ?s1 ?s2)
    :effect (scheduled ?s1 ?s2)
  )
)