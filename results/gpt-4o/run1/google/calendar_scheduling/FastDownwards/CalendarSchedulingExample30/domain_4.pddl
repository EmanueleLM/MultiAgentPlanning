(define (domain meeting_scheduling)
  (:requirements :strips :typing :negative-preconditions)
  (:types participant timeslot)
  (:predicates 
    (busy ?p - participant ?ts - timeslot)
    (preferred_before_14 ?p - participant)
    (available ?ts - timeslot)
    (meeting_scheduled ?ts - timeslot)
  )
  
  (:action schedule_meeting
    :parameters (?ts - timeslot)
    :precondition (and 
                   (available ?ts)
                   (not (busy jeffrey ?ts))
                   (not (busy virginia ?ts))
                   (not (busy melissa ?ts))
                   (or 
                     (not (preferred_before_14 melissa))
                     (or (equal ?ts timeslot_9_0) 
                         (equal ?ts timeslot_9_30)
                         (equal ?ts timeslot_10_0)
                         (equal ?ts timeslot_10_30)
                         (equal ?ts timeslot_11_0)
                         (equal ?ts timeslot_11_30)
                         (equal ?ts timeslot_12_0)
                         (equal ?ts timeslot_12_30)
                         (equal ?ts timeslot_13_0)
                         (equal ?ts timeslot_13_30)
                         (equal ?ts timeslot_14_0))
                   )
                  )
    :effect (meeting_scheduled ?ts)
  )
)