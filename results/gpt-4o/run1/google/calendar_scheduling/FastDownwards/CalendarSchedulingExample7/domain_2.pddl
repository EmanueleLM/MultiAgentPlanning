(define (domain meeting_scheduling)
  (:requirements :strips :typing :negative-preconditions)
  (:types participant timeslot)
  (:predicates
    (busy ?p - participant ?t - timeslot)
    (scheduled ?p - participant ?t - timeslot)
    (half_hour_block ?t_start - timeslot ?t_end - timeslot)
    (meeting_scheduled)
  )
  (:action schedule_meeting
    :parameters (?t_start - timeslot ?t_end - timeslot)
    :precondition (and
        (half_hour_block ?t_start ?t_end)
        (not (busy heather ?t_start))
        (not (busy heather ?t_end))
        (not (busy nicholas ?t_start))
        (not (busy nicholas ?t_end))
        (not (busy zachary ?t_start))
        (not (busy zachary ?t_end))
    )
    :effect (and
        (scheduled heather ?t_start)
        (scheduled heather ?t_end)
        (scheduled nicholas ?t_start)
        (scheduled nicholas ?t_end)
        (scheduled zachary ?t_start)
        (scheduled zachary ?t_end)
        (meeting_scheduled)
    )
  )
)