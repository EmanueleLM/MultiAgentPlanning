(define (domain meeting_planning_sf)
  (:requirements :strips :typing)
  (:types location person)
  (:predicates 
    (at ?loc - location)
    (joseph_at_nobhill)
    (met ?p - person)
    (time ?t)
    (time_block ?block - time)
    (available ?p - person)
  )
  (:action travel_chinatown_to_nobhill
    :parameters (?from - location ?to - location ?start - time ?end - time)
    :precondition (and (at ?from) (time_block ?start))
    :effect (and (not (at ?from)) 
                 (at ?to)
                 (time_block ?end)))
  (:action travel_nobhill_to_chinatown
    :parameters (?from - location ?to - location ?start - time ?end - time)
    :precondition (and (at ?from) (time_block ?start))
    :effect (and (not (at ?from))
                 (at ?to)
                 (time_block ?end)))
  (:action meet_joseph
    :parameters (?loc - location ?start - time ?end - time)
    :precondition (and (at ?loc)
                       (joseph_at_nobhill)
                       (available joseph)
                       (time_block ?start))
    :effect (and (met joseph)
                 (not (time_block ?start))
                 (time_block ?end)))
)