(define (domain san_francisco_visit)
  (:requirements :strips :typing)
  (:types location friend time)
  (:predicates
    (at_location ?loc - location)
    (friend_available ?friend - friend ?loc - location ?start - time ?end - time)
    (met_friend ?friend - friend)
    (current_time ?time - time)
    (next_time ?current - time ?next - time)
    (can_meet ?friend - friend ?duration_met - time)
  )
  (:action move_to_union_square
    :parameters (?current - time ?next - time)
    :precondition (and (at_location sunset_district)
                       (current_time ?current)
                       (next_time ?current ?next))
    :effect (and (not (at_location sunset_district))
                 (at_location union_square)
                 (not (current_time ?current))
                 (current_time ?next))
  )
  (:action move_to_sunset_district
    :parameters (?current - time ?next - time)
    :precondition (and (at_location union_square)
                       (current_time ?current)
                       (next_time ?current ?next))
    :effect (and (not (at_location union_square))
                 (at_location sunset_district)
                 (not (current_time ?current))
                 (current_time ?next))
  )
  (:action wait_in_union_square
    :parameters (?current - time ?next - time)
    :precondition (and (at_location union_square)
                       (current_time ?current)
                       (next_time ?current ?next))
    :effect (and (not (current_time ?current))
                 (current_time ?next))
  )
  (:action meet_sarah
    :parameters (?start - time ?during - time ?end - time)
    :precondition (and (at_location union_square)
                       (current_time ?start)
                       (friend_available sarah union_square ?start ?end)
                       (next_time ?start ?during)
                       (not (met_friend sarah)))
    :effect (and (met_friend sarah)
                 (can_meet sarah ?during))
  )
)