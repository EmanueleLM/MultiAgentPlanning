(define (domain san_francisco_meeting)
  (:requirements :strips :typing :negative-preconditions)
  (:types location person time)
  (:predicates 
    (at ?p - person ?l - location)
    (time ?t - time)
    (visited ?l - location)
    (met ?p - person ?l - location)
    (can_travel ?from - location ?to - location ?duration - time)
    (during_availability ?t1 - time ?t2 - time)
  )
  (:action travel
    :parameters (?from - location ?to - location ?duration - time)
    :precondition (and (at self ?from) (can_travel ?from ?to ?duration) (time time_9am))
    :effect (and (not (at self ?from)) (at self ?to))
  )
  (:action meet_stephanie
    :parameters (?l - location)
    :precondition (and (at stephanie ?l) (at self ?l) 
                       (during_availability time_445pm time_945pm) 
                       (time time_9am))
    :effect (and (met stephanie ?l) (visited ?l))
  )
)