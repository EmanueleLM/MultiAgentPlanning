(define (domain san_francisco_meeting)
  (:requirements :strips :typing :negative-preconditions)
  (:types location person time_stage)
  (:predicates 
    (at ?p - person ?l - location)
    (current_location ?l - location)
    (time_at ?t - time_stage)
    (visited ?l - location)
    (met_duration_achieved)
    (met ?p - person)
    (can_travel ?from - location ?to - location ?duration - time_stage)
    (available ?p - person ?t1 - time_stage ?t2 - time_stage)
  )
  (:action travel
    :parameters (?from - location ?to - location ?duration_start - time_stage ?duration_end - time_stage)
    :precondition (and (current_location ?from) (can_travel ?from ?to ?duration_start) (time_at ?duration_end))
    :effect (and (not (current_location ?from)) (current_location ?to) (time_at ?duration_end))
  )
  (:action wait
    :parameters (?current - location ?duration_start - time_stage ?duration_end - time_stage)
    :precondition (and (current_location ?current) (time_at ?duration_end))
    :effect (and (time_at ?duration_end))
  )
  (:action meet
    :parameters (?p - person ?l - location ?duration_start - time_stage ?duration_end - time_stage)
    :precondition (and (at ?p ?l) (current_location ?l) (available ?p ?duration_start ?duration_end) (time_at ?duration_end))
    :effect (and (met ?p) (met_duration_achieved))
  )
)