(define (problem meet_jessica)
  (:domain visit_san_francisco)
  (:objects 
    minute_0 minute_10 minute_15 minute_20 minute_30 minute_40 minute_50 minute_60 
    minute_70 minute_80 minute_90 minute_100 minute_110 minute_120 minute_130 
    minute_140 minute_150 minute_160 minute_170 minute_180 minute_190 minute_200 
    minute_210 minute_220 minute_230 minute_240 minute_250 minute_260 minute_270 
    - time_increment
  )
  (:init 
    (at presidio)
    (time minute_0)
    (succeeding_time minute_0 minute_10)
    (succeeding_time minute_10 minute_20)
    (succeeding_time minute_20 minute_30)
    (succeeding_time minute_30 minute_40)
    (succeeding_time minute_40 minute_50)
    (succeeding_time minute_50 minute_60)
    (succeeding_time minute_60 minute_70)
    (succeeding_time minute_70 minute_80)
    (succeeding_time minute_80 minute_90)
    (succeeding_time minute_90 minute_100)
    (succeeding_time minute_100 minute_110)
    (succeeding_time minute_110 minute_120)
    (succeeding_time minute_120 minute_130)
    (succeeding_time minute_130 minute_140)
    (succeeding_time minute_140 minute_150)
    (succeeding_time minute_150 minute_160)
    (succeeding_time minute_160 minute_170)
    (succeeding_time minute_170 minute_180)
    (succeeding_time minute_180 minute_190)
    (succeeding_time minute_190 minute_200)
    (succeeding_time minute_200 minute_210)
    (succeeding_time minute_210 minute_220)
    (succeeding_time minute_220 minute_230)
    (succeeding_time minute_230 minute_240)
    (succeeding_time minute_240 minute_250)
    (succeeding_time minute_250 minute_260)
    (succeeding_time minute_260 minute_270)
    (forall (?t - time_increment) (=
      (num_steps ?t ?t) 0
    ))
    (forall (?t1 - time_increment ?t2 - time_increment)
      (imply (succeeding_time ?t1 ?t2)
        (= (num_steps ?t2 ?t1) 1)
      )
    )
    ;; Jessica's availability at time intervals
    (jessica_available minute_15)
    (jessica_available minute_20)
    (jessica_available minute_30)
    (jessica_available minute_40)
    (jessica_available minute_50)
    (jessica_available minute_60)
    (jessica_available minute_70)
    (jessica_available minute_80)
    (jessica_available minute_90)
    (jessica_available minute_100)
    (jessica_available minute_110)
    (jessica_available minute_120)
    (jessica_available minute_130)
    (jessica_available minute_140)
    (jessica_available minute_150)
    (jessica_available minute_160)
    (jessica_available minute_170)
    (jessica_available minute_180)
    (jessica_available minute_190)
    (jessica_available minute_200)
    (jessica_available minute_210)
    (jessica_available minute_220)
    (jessica_available minute_230)
    (jessica_available minute_240)
    (jessica_available minute_250)
    (jessica_available minute_260)
    (jessica_available minute_270)
  )
  (:goal (met_for_minimum jessica))
)