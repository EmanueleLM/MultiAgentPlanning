(define (problem european_trip_instance)
  (:domain european_trip)
  (:objects 
    valencia amsterdam tallinn - city
    day_1 day_2 day_3 day_4 day_5 day_6 day_7 day_8 day_9 day_10 day_11 day_12 day_13 day_14 day_15 - day
  )

  (:init 
    (at valencia)
    (next_day day_1 day_2)
    (next_day day_2 day_3)
    (next_day day_3 day_4)
    (next_day day_4 day_5)
    (next_day day_5 day_6)
    (next_day day_6 day_7)
    (next_day day_7 day_8)
    (next_day day_8 day_9)
    (next_day day_9 day_10)
    (next_day day_10 day_11)
    (next_day day_11 day_12)
    (next_day day_12 day_13)
    (next_day day_13 day_14)
    (next_day day_14 day_15)
    ;; Meeting is possible between day 9 and day 15
    (meeting_possible day_9)
    (meeting_possible day_10)
    (meeting_possible day_11)
    (meeting_possible day_12)
    (meeting_possible day_13)
    (meeting_possible day_14)
    (meeting_possible day_15)
  )

  (:goal (and 
    (exists (?d1 ?d2 ?d3 ?d4 ?d5 - day)
      (and (day_visited valencia ?d1)
           (day_visited valencia ?d2)
           (day_visited valencia ?d3)
           (day_visited valencia ?d4)
           (day_visited valencia ?d5)))
    (exists (?d1 ?d2 ?d3 ?d4 ?d5 - day)
      (and (day_visited amsterdam ?d1)
           (day_visited amsterdam ?d2)
           (day_visited amsterdam ?d3)
           (day_visited amsterdam ?d4)
           (day_visited amsterdam ?d5)))
    (exists (?d1 ?d2 ?d3 ?d4 ?d5 ?d6 ?d7 - day)
      (and (day_visited tallinn ?d1)
           (day_visited tallinn ?d2)
           (day_visited tallinn ?d3)
           (day_visited tallinn ?d4)
           (day_visited tallinn ?d5)
           (day_visited tallinn ?d6)
           (day_visited tallinn ?d7)))
    (exists (?d - day) (and (day_visited tallinn ?d) (meeting_possible ?d)))
  ))
)