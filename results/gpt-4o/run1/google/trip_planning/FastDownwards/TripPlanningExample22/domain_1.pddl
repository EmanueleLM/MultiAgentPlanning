(define (domain european_trip)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day)
  (:predicates
    (at ?c - city ?d - day)
    (can_travel ?from - city ?to - city)
    (visited ?c - city)
    (in_berlin_show ?d - day)
    (next_day ?current - day ?next - day)
  )
  (:action travel
    :parameters (?from - city ?to - city ?current - day ?next - day)
    :precondition (and (can_travel ?from ?to)
                       (at ?from ?current)
                       (next_day ?current ?next))
    :effect (and (not (at ?from ?current))
                 (at ?to ?next)
                 (visited ?to))
  )
  (:action move_to_next_day
    :parameters (?current - day ?next - day)
    :precondition (next_day ?current ?next)
    :effect (and (forall (?c - city) (not (at ?c ?current)))
                 (exists (?c - city) (at ?c ?next)))
  )
)