(define (domain european_trip)
  (:requirements :strips :typing)
  (:types city day)
  (:predicates
    (at ?c - city ?d - day)
    (can_travel ?from - city ?to - city)
    (visited ?c - city ?d1 - day ?d2 - day)
    (next_day ?current - day ?next - day)
  )
  (:action travel
    :parameters (?from - city ?to - city ?current - day ?next - day)
    :precondition (and (can_travel ?from ?to)
                       (at ?from ?current)
                       (next_day ?current ?next))
    :effect (and (not (at ?from ?current))
                 (at ?to ?next))
  )
  (:action stay
    :parameters (?c - city ?current - day ?next - day)
    :precondition (and (at ?c ?current)
                       (next_day ?current ?next))
    :effect (and (not (at ?c ?current))
                 (at ?c ?next))
  )
  (:action visit
    :parameters (?c - city ?start - day ?end - day)
    :precondition (and (at ?c ?start)
                       (at ?c ?end)
                       (next_day ?start ?end))
    :effect (visited ?c ?start ?end)
  )
)