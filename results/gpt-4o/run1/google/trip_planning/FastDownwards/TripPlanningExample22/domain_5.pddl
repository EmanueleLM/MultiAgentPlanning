(define (domain european_trip)
  (:requirements :strips :typing)
  (:types city day)
  (:predicates
    (at ?c - city ?d - day)
    (can_fly ?from - city ?to - city)
    (next_day ?current - day ?next - day)
    (visited_berlin ?d1 - day ?d2 - day)
    (attended_show ?d1 - day ?d2 - day)
    (visited_frankfurt ?d1 - day ?d2 - day)
    (visited_bucharest ?d1 - day ?d2 - day)
  )
  (:action fly
    :parameters (?from - city ?to - city ?current - day ?next - day)
    :precondition (and (can_fly ?from ?to)
                       (at ?from ?current)
                       (next_day ?current ?next))
    :effect (and (not (at ?from ?current))
                 (at ?to ?next))
  )
  (:action stay
    :parameters (?c - city ?current - day ?next - day)
    :precondition (and (at ?c ?current)
                       (next_day ?current ?next))
    :effect (and (not (at ?c ?current))
                 (at ?c ?next))
  )
  (:action visit_berlin
    :parameters (?start - day ?end - day)
    :precondition (and (at berlin ?start)
                       (at berlin ?end)
                       (next_day ?start ?end))
    :effect (visited_berlin ?start ?end)
  )
  (:action visit_frankfurt
    :parameters (?start - day ?end - day)
    :precondition (and (at frankfurt ?start)
                       (at frankfurt ?end)
                       (next_day ?start ?end))
    :effect (visited_frankfurt ?start ?end)
  )
  (:action visit_bucharest
    :parameters (?start - day ?end - day)
    :precondition (and (at bucharest ?start)
                       (at bucharest ?end)
                       (next_day ?start ?end))
    :effect (visited_bucharest ?start ?end)
  )
  (:action attend_show
    :parameters (?start - day ?end - day)
    :precondition (and (at berlin ?start)
                       (at berlin ?end)
                       (next_day ?start ?end))
    :effect (attended_show ?start ?end)
  )
)