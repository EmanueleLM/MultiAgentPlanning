(define (problem plan_european_trip)
  (:domain european_trip)
  (:objects
    bucharest zurich dubrovnik - city
    day1 day2 day3 day4 day5 day6 day7 day8 day9 day10 - day
  )
  (:init
    (in_city bucharest)
    (current_day day1)
    (day_number day1 1)
    (day_number day2 2)
    (day_number day3 3)
    (day_number day4 4)
    (day_number day5 5)
    (day_number day6 6)
    (day_number day7 7)
    (day_number day8 8)
    (day_number day9 9)
    (day_number day10 10)
    (next_day day1 day2)
    (next_day day2 day3)
    (next_day day3 day4)
    (next_day day4 day5)
    (next_day day5 day6)
    (next_day day6 day7)
    (next_day day7 day8)
    (next_day day8 day9)
    (next_day day9 day10)
  )
  (:goal (and
    (has_visited bucharest)
    (has_visited zurich)
    (has_visited dubrovnik)
    (in_city dubrovnik) ; Must end in Dubrovnik as it's visited last.
    (or 
      (and (current_day day10) (in_city dubrovnik))
      (and (current_day day9) (in_city dubrovnik))
      (and (current_day day8) (in_city dubrovnik))
      (and (current_day day7) (in_city dubrovnik))
      (and (current_day day6) (in_city dubrovnik))
      (and (current_day day5) (in_city dubrovnik))
      (and (current_day day4) (in_city dubrovnik))
    )
  ))
)