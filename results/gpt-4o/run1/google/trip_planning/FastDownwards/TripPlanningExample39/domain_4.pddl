(define (domain travel_planner)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day)
  (:predicates
    (at ?city - city ?day - day)
    (next_day ?current - day ?next - day)
    (flight_available ?from - city ?to - city)
    ; Track the last day spent at each city
    (last_day_at_porto ?day - day)
    (last_day_at_barcelona ?day - day)
    (last_day_at_florence ?day - day)
  )
  (:action fly
    :parameters (?from - city ?to - city ?current - day ?next - day)
    :precondition (and (at ?from ?current)
                       (flight_available ?from ?to) 
                       (next_day ?current ?next))
    :effect (and (not (at ?from ?current)) 
                 (at ?to ?next))
  )
  (:action stay
    :parameters (?city - city ?current - day ?next - day ?last - day)
    :precondition (and (at ?city ?current) 
                       (next_day ?current ?next)
                       (not (last_day_at_florence ?current))  ; Cannot stay beyond the planned days
                       (not (last_day_at_barcelona ?current)) 
                       (not (last_day_at_porto ?current)))
    :effect (and (not (at ?city ?current)) 
                 (at ?city ?next)
                 (or (and (last_day_at_porto ?last) (at porto ?next))
                     (and (last_day_at_barcelona ?last) (at barcelona ?next))
                     (and (last_day_at_florence ?last) (at florence ?next))))
  )
)