(define (problem visit_cities)
  (:domain trip_plan)
  (:objects 
    venice dubrovnik istanbul - city
    day1 day2 day3 day4 day5 day6 day7 day8 day9 day10 day11 - day
  )
  (:init 
    (at venice day1)
    (next_day day1 day2)
    (next_day day2 day3)
    (next_day day3 day4)
    (next_day day4 day5)
    (next_day day5 day6)
    (next_day day6 day7)
    (next_day day7 day8)
    (next_day day8 day9)
    (next_day day9 day10)
    (next_day day10 day11)
    (not (visited istanbul))
    (not (visited dubrovnik))
    (not (visited venice))
  )
  (:goal (and
    (visited venice)
    (visited dubrovnik)
    (visited istanbul)
    (at venice day6)
    (at dubrovnik day10)
    (at istanbul day11))
  )
)