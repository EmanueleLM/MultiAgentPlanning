(define (domain logistics)
    (:requirements :strips :typing :negative-preconditions)
    (:types place surface crate pallet truck hoist)
    
    (:predicates
        (at ?entity ?place)
        (on ?crate ?surface)
        (in ?crate ?truck)
        (available ?hoist)
        (lifting ?hoist ?crate)
        (clear ?surface)
        (hoist-at ?hoist ?place)
        (truck-at ?truck ?place)
    )
    
    (:action drive
        :parameters (?truck - truck ?origin ?destination - place)
        :precondition (and (truck-at ?truck ?origin) (at ?truck ?origin))
        :effect (and (not (truck-at ?truck ?origin))
                     (truck-at ?truck ?destination)
                     (not (at ?truck ?origin))
                     (at ?truck ?destination))
    )
    
    (:action lift
        :parameters (?hoist - hoist ?crate - crate ?surface - surface ?place - place)
        :precondition (and (at ?crate ?place) 
                           (clear ?crate)
                           (available ?hoist)
                           (hoist-at ?hoist ?place)
                           (on ?crate ?surface))
        :effect (and (lifting ?hoist ?crate)
                     (not (available ?hoist))
                     (not (at ?crate ?place))
                     (clear ?surface)
                     (not (on ?crate ?surface)))
    )
    
    (:action drop
        :parameters (?hoist - hoist ?crate - crate ?surface - surface ?place - place)
        :precondition (and (lifting ?hoist ?crate) 
                           (clear ?surface)
                           (hoist-at ?hoist ?place))
        :effect (and (not (lifting ?hoist ?crate))
                     (available ?hoist)
                     (at ?crate ?place)
                     (not (clear ?surface))
                     (on ?crate ?surface))
    )
    
    (:action load
        :parameters (?hoist - hoist ?crate - crate ?truck - truck ?place - place)
        :precondition (and (lifting ?hoist ?crate) 
                           (truck-at ?truck ?place)
                           (hoist-at ?hoist ?place))
        :effect (and (not (lifting ?hoist ?crate))
                     (available ?hoist)
                     (in ?crate ?truck))
    )
    
    (:action unload
        :parameters (?hoist - hoist ?crate - crate ?truck - truck ?place - place)
        :precondition (and (in ?crate ?truck) 
                           (available ?hoist)
                           (truck-at ?truck ?place)
                           (hoist-at ?hoist ?place))
        :effect (and (lifting ?hoist ?crate)
                     (not (available ?hoist))
                     (not (in ?crate ?truck)))
    )
)