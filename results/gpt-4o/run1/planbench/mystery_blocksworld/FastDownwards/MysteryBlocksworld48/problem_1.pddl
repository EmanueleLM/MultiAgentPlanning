(define (problem object_craving_problem)
  (:domain object_transitions)
  (:objects a b c d - object)
  (:init
    (object_craves b c)
    (harmony)
    (planet a) (planet c) (planet d)
    (province a) (province b) (province d)
  )
  (:goal (and
    (object_craves a b)
    (object_craves b c)
    (object_craves c d)
  ))
)