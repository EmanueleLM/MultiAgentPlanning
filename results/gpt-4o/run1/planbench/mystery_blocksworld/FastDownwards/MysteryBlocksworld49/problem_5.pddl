(define (problem manage_cravings)
  (:domain dynamic_state_transition_puzzle)
  (:objects a b c d - object)
  (:init 
    (craves a c)
    (craves d b)
    (planet b)
    (planet c)
    (province a)
    (province d)
    (harmony)
  )
  (:goal 
    (and (craves a b) 
         (craves b c)
         (craves c d))
  )
)