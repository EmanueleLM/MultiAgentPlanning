(define (domain object_manipulation)
  (:requirements :strips :negative-preconditions :typing)
  (:predicates
    (hand ?x)
    (cats ?x)
    (texture ?x)
    (vase ?x ?y)
    (next ?x ?y)
    (sneeze ?x)
    (spring ?x)
    (collect ?x ?y)
    (stupendous ?x)
  )
  (:action paltry
    :parameters (?ob0 ?ob1 ?ob2)
    :precondition (and (hand ?ob0) (cats ?ob1) (texture ?ob2) (vase ?ob0 ?ob1) (next ?ob1 ?ob2))
    :effect (and (next ?ob0 ?ob2) (not (vase ?ob0 ?ob1)))
  )
  (:action sip
    :parameters (?ob0 ?ob1 ?ob2)
    :precondition (and (hand ?ob0) (cats ?ob1) (texture ?ob2) (next ?ob0 ?ob2) (next ?ob1 ?ob2))
    :effect (and (vase ?ob0 ?ob1) (not (next ?ob0 ?ob2)))
  )
  (:action clip
    :parameters (?ob0 ?ob1 ?ob2)
    :precondition (and (hand ?ob0) (sneeze ?ob1) (texture ?ob2) (next ?ob1 ?ob2) (next ?ob0 ?ob2))
    :effect (and (vase ?ob0 ?ob1) (not (next ?ob0 ?ob2)))
  )
  (:action wretched
    :parameters (?ob0 ?ob1 ?ob2 ?ob3)
    :precondition (and (sneeze ?ob0) (texture ?ob1) (texture ?ob2) (stupendous ?ob3)
                       (next ?ob0 ?ob1) (collect ?ob1 ?ob3) (collect ?ob2 ?ob3))
    :effect (and (next ?ob0 ?ob2) (not (next ?ob0 ?ob1)))
  )
  (:action memory
    :parameters (?ob0 ?ob1 ?ob2)
    :precondition (and (cats ?ob0) (spring ?ob1) (spring ?ob2) (next ?ob0 ?ob1))
    :effect (and (next ?ob0 ?ob2) (not (next ?ob0 ?ob1)))
  )
  (:action tightfisted
    :parameters (?ob0 ?ob1 ?ob2)
    :precondition (and (hand ?ob0) (sneeze ?ob1) (texture ?ob2) (next ?ob1 ?ob2) (vase ?ob0 ?ob1))
    :effect (and (next ?ob0 ?ob2) (not (vase ?ob0 ?ob1)))
  )
)