(define (domain sokoban)
  (:requirements :strips :typing :negative-preconditions)
  (:types location movable)
  (:predicates 
    (at ?entity - movable ?loc - location)
    (goal_at ?loc - location)
    (is_wall ?loc - location)
    (adjacent ?loc1 - location ?loc2 - location)
    (box_at_goal ?loc - location)
    (is_player ?entity - movable)
    (is_box ?entity - movable)
  )
  (:action move
    :parameters (?player - movable ?from - location ?to - location)
    :precondition (and
      (at ?player ?from)
      (adjacent ?from ?to)
      (not (is_wall ?to))
      (not (exists (?box - movable) (and (is_box ?box) (at ?box ?to))))
      (is_player ?player)
    )
    :effect (and
      (not (at ?player ?from))
      (at ?player ?to)
    )
  )
  (:action push
    :parameters (?player - movable ?box - movable ?from - location ?box_from - location ?box_to - location)
    :precondition (and
      (at ?player ?from)
      (at ?box ?box_from)
      (adjacent ?from ?box_from)
      (adjacent ?box_from ?box_to)
      (not (is_wall ?box_to))
      (not (exists (?entity - movable) (at ?entity ?box_to)))
      (is_player ?player)
      (is_box ?box)
    )
    :effect (and
      (not (at ?box ?box_from))
      (at ?box ?box_to)
      (not (at ?player ?from))
      (at ?player ?box_from)
    )
  )
  (:action check_goal
    :parameters (?box - movable ?loc - location)
    :precondition (and
      (goal_at ?loc)
      (at ?box ?loc)
      (is_box ?box)
    )
    :effect (box_at_goal ?loc)
  )
)