(define (domain sokoban)
    (:requirements :strips :typing :negative-preconditions)
    (:types entity cell wall floor goal - cell)
    (:predicates
        (at ?e - entity ?c - cell)
        (is-goal ?c - cell)
        (adjacent ?c1 ?c2 - cell)
        (clear ?c - cell)
        (is-box ?e - entity)
        (is-player ?e - entity)
        (on-goal ?box - entity)
    )
    (:action move
        :parameters (?from - cell ?to - cell)
        :precondition (and
            (at player ?from)
            (clear ?to)
            (adjacent ?from ?to)
        )
        :effect (and
            (not (at player ?from))
            (at player ?to)
        )
    )
    (:action push
        :parameters (?from - cell ?to - cell ?box_loc - cell)
        :precondition (and
            (at player ?from)
            (adjacent ?from ?box_loc)
            (at box1 ?box_loc)
            (adjacent ?box_loc ?to)
            (clear ?to)
            (is-box box1)
        )
        :effect (and
            (not (at player ?from))
            (not (at box1 ?box_loc))
            (at player ?box_loc)
            (at box1 ?to)
            (when (is-goal ?box_loc) (not (on-goal box1)))
            (when (is-goal ?to) (on-goal box1))
        )
    )
)