(define (domain sokoban)
    (:requirements :strips :typing :negative-preconditions)
    (:types entity cell)
    (:predicates
        (at ?e - entity ?c - cell)
        (is-goal ?c - cell)
        (adjacent ?c1 ?c2 - cell)
        (clear ?c - cell)
        (is-box ?e - entity)
        (is-player ?e - entity)
        (on-goal ?e - entity)
    )
    (:action move
        :parameters (?player - entity ?from - cell ?to - cell)
        :precondition (and
            (is-player ?player)
            (at ?player ?from)
            (clear ?to)
            (adjacent ?from ?to)
        )
        :effect (and
            (not (at ?player ?from))
            (at ?player ?to)
        )
    )
    (:action push
        :parameters (?player - entity ?from - cell ?box_loc - cell ?to - cell ?box - entity)
        :precondition (and
            (is-player ?player)
            (at ?player ?from)
            (adjacent ?from ?box_loc)
            (is-box ?box)
            (at ?box ?box_loc)
            (adjacent ?box_loc ?to)
            (clear ?to)
        )
        :effect (and
            (not (at ?player ?from))
            (not (at ?box ?box_loc))
            (at ?player ?box_loc)
            (at ?box ?to)
            (when (is-goal ?box_loc) (not (on-goal ?box)))
            (when (is-goal ?to) (on-goal ?box))
        )
    )
)