(define (domain sokoban)
  (:requirements :strips :typing)
  (:types player box wall)
  (:predicates
    (at-player ?cell)
    (at-box ?cell)
    (goal ?cell)
    (free ?cell)
    (adjacent ?cell1 ?cell2)
  )
  (:action move
    :parameters (?from ?to)
    :precondition (and (at-player ?from) (free ?to) (adjacent ?from ?to))
    :effect (and 
      (not (at-player ?from))
      (at-player ?to)
      (free ?from)
      (not (free ?to))
    )
  )
  (:action push
    :parameters (?player ?box ?from ?to ?dest)
    :precondition (and 
      (at-player ?from)
      (at-box ?to)
      (free ?dest)
      (adjacent ?from ?to)
      (adjacent ?to ?dest)
    )
    :effect (and 
      (not (at-player ?from))
      (at-player ?to)
      (not (at-box ?to))
      (at-box ?dest)
      (free ?from)
      (not (free ?dest))
    )
  )
)