(define (domain sokoban)
  (:requirements :strips :typing)
  (:types player box wall cell)
  (:predicates
    (at-player ?p - player ?c - cell)
    (at-box ?b - box ?c - cell)
    (goal ?c - cell)
    (free ?c - cell)
    (adjacent ?c1 - cell ?c2 - cell)
  )
  (:action move
    :parameters (?p - player ?from - cell ?to - cell)
    :precondition (and (at-player ?p ?from) (free ?to) (adjacent ?from ?to))
    :effect (and 
      (not (at-player ?p ?from))
      (at-player ?p ?to)
      (free ?from)
      (not (free ?to))
    )
  )
  (:action push
    :parameters (?p - player ?b - box ?from - cell ?to - cell ?dest - cell)
    :precondition (and 
      (at-player ?p ?from)
      (at-box ?b ?to)
      (free ?dest)
      (adjacent ?from ?to)
      (adjacent ?to ?dest)
    )
    :effect (and 
      (not (at-player ?p ?from))
      (at-player ?p ?to)
      (not (at-box ?b ?to))
      (at-box ?b ?dest)
      (free ?from)
      (not (free ?dest))
    )
  )
)