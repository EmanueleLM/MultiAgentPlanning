(define (domain scheduling-temporal-discrete)
  (:requirements :strips :typing :negative-preconditions)
  (:types person location timeslot meeting)

  (:predicates
    (at ?p - person ?l - location ?t - timeslot)    ; person p is at location l during slot t
    (busy ?p - person ?t - timeslot)                ; person p is occupied during slot t
    (meeting-scheduled ?m - meeting)                ; meeting m has been scheduled
    (meeting-location ?m - meeting ?l - location)   ; meeting m takes place at location l
  )

  ;; Grounded travel actions: Chinatown -> MarinaDistrict, travel duration 12 minutes (slots).
  ;; Each action starts at an explicit timeslot tN, occupies slots tN .. tN+11, and arrives at tN+12.
  ;; On arrival we assert the traveler's presence at MarinaDistrict for that arrival slot and all subsequent slots
  ;; (so the traveler cannot "teleport" away without another travel action).
  ;; We provide travel actions for start times t0 .. t13 (arrival t12 .. t25). Only those relevant to the instance
  ;; (meeting must start no later than t13 to fit 105-minute meeting within horizon) are included.

  (:action travel-chinatown-to-marina-start-t0
    :parameters ()
    :precondition (and
      (at traveler Chinatown t0)
      (not (busy traveler t0)) (not (busy traveler t1)) (not (busy traveler t2)) (not (busy traveler t3))
      (not (busy traveler t4)) (not (busy traveler t5)) (not (busy traveler t6)) (not (busy traveler t7))
      (not (busy traveler t8)) (not (busy traveler t9)) (not (busy traveler t10)) (not (busy traveler t11))
    )
    :effect (and
      (busy traveler t0) (busy traveler t1) (busy traveler t2) (busy traveler t3)
      (busy traveler t4) (busy traveler t5) (busy traveler t6) (busy traveler t7)
      (busy traveler t8) (busy traveler t9) (busy traveler t10) (busy traveler t11)
      ;; arrival at t12 and remain at MarinaDistrict for all subsequent slots through horizon
      (at traveler MarinaDistrict t12) (at traveler MarinaDistrict t13) (at traveler MarinaDistrict t14)
      (at traveler MarinaDistrict t15) (at traveler MarinaDistrict t16) (at traveler MarinaDistrict t17)
