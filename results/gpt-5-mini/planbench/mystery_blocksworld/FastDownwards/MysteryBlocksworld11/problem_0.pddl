; Problem: achieve craves(a,b)
; Comment: Initial facts follow the example public initial facts from the specification.
; - Objects: a, b, c, d (typed as entity)
; - Initial facts: craves(c,b), craves(d,a), harmony, planet(a), planet(b), province(c), province(d)
; Goal: craves(a,b)
(define (problem make-a-crave-b)
  (:domain orchestration)
  (:objects a b c d - entity)
  (:init
    (craves c b)
    (craves d a)
    (harmony)
    (planet a)
    (planet b)
    (province c)
    (province d)
  )
  (:goal (and (craves a b)))
)