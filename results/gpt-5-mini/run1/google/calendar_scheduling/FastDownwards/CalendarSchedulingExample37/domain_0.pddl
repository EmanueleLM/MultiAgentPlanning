(define (domain jack_of_all_trades_schedule)
  (:requirements :strips :typing :negative-preconditions)
  (:types participant timeslot meeting_state)
  (:predicates
    (person ?p - participant)
    (slot ?s - timeslot)
    (work_slot ?s - timeslot)
    (blocked ?p - participant ?s - timeslot)
    (meeting_unscheduled)
    (meeting_scheduled)
    (scheduled_at ?s - timeslot)
  )
  (:action schedule_meeting_at
    :parameters (?s - timeslot)
    :precondition (and
      (slot ?s)
      (work_slot ?s)
      (meeting_unscheduled)
      (not (blocked gregory ?s))
      (not (blocked teresa ?s))
      (not (blocked carol ?s))
      (not (meeting_scheduled))
    )
    :effect (and
      (meeting_scheduled)
      (scheduled_at ?s)
      (not (meeting_unscheduled))
    )
  )
)