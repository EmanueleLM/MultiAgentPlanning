(define (domain jack_of_all_trades)
  (:requirements :strips :typing :negative-preconditions)
  (:types person slot)
  (:constants david eric roger - person)
  (:predicates
    (busy ?p - person ?s - slot)
    (next ?s1 - slot ?s2 - slot)
    (meeting_scheduled)
    (meeting_start ?s - slot)
  )
  (:action schedule_meeting
    :parameters (?s - slot ?s2 - slot)
    :precondition (and
      (next ?s ?s2)
      (not (meeting_scheduled))
      (not (busy david ?s))
      (not (busy david ?s2))
      (not (busy eric ?s))
      (not (busy eric ?s2))
      (not (busy roger ?s))
      (not (busy roger ?s2))
    )
    :effect (and
      (meeting_scheduled)
      (meeting_start ?s)
      (busy david ?s)
      (busy david ?s2)
      (busy eric ?s)
      (busy eric ?s2)
      (busy roger ?s)
      (busy roger ?s2)
    )
  )
)