(define (domain MeetingPlanningExample22)
  (:requirements :strips :typing :negative-preconditions)
  (:types agent location time)
  (:predicates
    (at ?a - agent ?l - location)
    (at-time ?a - agent ?t - time)
    (andrew-at ?t - time)
    (can-travel ?from - location ?to - location ?tfrom - time ?tto - time)
    (can-wait ?tfrom - time ?tto - time)
    (can-meet ?tfrom - time ?tto - time)
    (meeting-in-progress)
    (met-andrew)
  )
  (:action travel
    :parameters (?a - agent ?from - location ?to - location ?tfrom - time ?tto - time)
    :precondition (and (at ?a ?from) (at-time ?a ?tfrom) (can-travel ?from ?to ?tfrom ?tto))
    :effect (and (not (at ?a ?from)) (at ?a ?to) (not (at-time ?a ?tfrom)) (at-time ?a ?tto))
  )
  (:action wait
    :parameters (?a - agent ?tfrom - time ?tto - time)
    :precondition (and (at-time ?a ?tfrom) (can-wait ?tfrom ?tto))
    :effect (and (not (at-time ?a ?tfrom)) (at-time ?a ?tto))
  )
  (:action meet-andrew
    :parameters (?a - agent ?loc - location ?tstart - time ?tend - time)
    :precondition (and (at ?a ?loc) (at-time ?a ?tstart) (andrew-at ?tstart) (andrew-at ?tend) (can-meet ?tstart ?tend))
    :effect (and (not (at-time ?a ?tstart)) (at-time ?a ?tend) (met-andrew))
  )
)