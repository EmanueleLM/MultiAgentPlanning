      (not (valencia_count_0))
      (valencia_count_1)
    )
  )

  (:action stay_oslo_day_1_day_2
    :parameters ()
    :precondition (and
      (at oslo)
      (current_day day_1)
      (next_day day_1 day_2)
      (not (start_unset))
      (present oslo day_1)
      (oslo_count_1)
      (not (present oslo day_2))
      (not (present dublin day_2))
      (not (present valencia day_2))
    )
    :effect (and
      (not (current_day day_1))
      (current_day day_2)
      (present oslo day_2)
      (not (oslo_count_1))
      (oslo_count_2)
    )
  )

