(define (domain european_trip_9_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (next_day ?d - day ?nd - day)
    (direct ?from - city ?to - city)
    (present ?c - city ?d - day)
    (start_unset)

    (oslo_count_0)
    (oslo_count_1)
    (oslo_count_2)
    (oslo_count_3)

    (dublin_count_0)
    (dublin_count_1)
    (dublin_count_2)
    (dublin_count_3)

    (valencia_count_0)
    (valencia_count_1)
    (valencia_count_2)
    (valencia_count_3)
    (valencia_count_4)
    (valencia_count_5)

    (visited_valencia_window)
  )

  (:action choose_start_oslo
    :parameters ()
    :precondition (and
      (start_unset)
      (current_day day_1)
      (oslo_count_0)
      (dublin_count_0)
      (valencia_count_0)
      (not (present oslo day_1))
      (not (present dublin day_1))
      (not (present valencia day_1))
    )
    :effect (and
      (not (start_unset))
      (at oslo)
      (present oslo day_1)
      (not (oslo_count_0))
      (oslo_count_1)
    )
  )

  (:action choose_start_dublin
    :parameters ()
    :precondition (and
      (start_unset)
      (current_day day_1)
      (oslo_count_0)
      (dublin_count_0)
      (valencia_count_0)
      (not (present oslo day_1))
      (not (present dublin day_1))
      (not (present valencia day_1))
    )
    :effect (and
      (not (start_unset))
      (at dublin)
      (present dublin day_1)
      (not (dublin_count_0))
      (dublin_count_1)
    )
  )

  (:action choose_start_valencia
    :parameters ()
    :precondition (and
      (start_unset)
      (current_day day_1)
      (oslo_count_0)
      (dublin_count_0)
      (valencia_count_0)
      (not (present oslo day_1))
      (not (present dublin day_1))
      (not (present valencia day_1))
    )
    :effect (and
