(define (domain european_trip_9_days_instance)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day)

  (:predicates
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (last_day ?d - day)
    (at ?c - city)
    (flight ?from - city ?to - city)
    (visited ?d - day ?c - city)
    (assigned ?d - day)
    (workshop_window ?d - day)
    (attended_workshop)

    (prague_count_0)
    (prague_count_1)
    (prague_count_2)
    (prague_count_3)

    (vienna_count_0)
    (vienna_count_1)
    (vienna_count_2)
    (vienna_count_3)

    (porto_count_0)
    (porto_count_1)
    (porto_count_2)
    (porto_count_3)
    (porto_count_4)
    (porto_count_5)
  )

  (:action assign_first_day_stay_prague
    :parameters (?d1 - day ?d2 - day)
    :precondition (and
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at prague)
      (not (assigned ?d1))
      (prague_count_0)
    )
    :effect (and
      (visited ?d1 prague)
      (assigned ?d1)
      (not (current_day ?d1))
      (current_day ?d2)
      (not (prague_count_0))
      (prague_count_1)
    )
  )

  (:action assign_first_day_stay_prague_and_attend_workshop_from_0
