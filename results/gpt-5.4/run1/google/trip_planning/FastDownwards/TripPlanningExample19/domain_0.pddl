(define (domain europe_trip_9_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (trip_not_started)
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (current_city ?c - city)
    (direct_flight ?from - city ?to - city)
    (occupied_on ?c - city ?d - day)

    (meeting_satisfied)

    (b_count_0)
    (b_count_1)
    (b_count_2)

    (v_count_0)
    (v_count_1)
    (v_count_2)
    (v_count_3)

    (n_count_0)
    (n_count_1)
    (n_count_2)
    (n_count_3)
    (n_count_4)
    (n_count_5)
    (n_count_6)
  )

  (:action start_in_brussels
    :parameters ()
    :precondition (trip_not_started)
    :effect (and
      (not (trip_not_started))
      (current_day day_1)
      (current_city brussels)
      (occupied_on brussels day_1)

      (not (b_count_0))
      (b_count_1)
    )
  )

  (:action start_in_valencia
    :parameters ()
    :precondition (trip_not_started)
    :effect (and
      (not (trip_not_started))
      (current_day day_1)
