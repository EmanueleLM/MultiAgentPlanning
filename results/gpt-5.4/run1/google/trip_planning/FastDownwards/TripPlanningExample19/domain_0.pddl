      (occupied_on valencia day_1)

      (not (v_count_0))
      (v_count_1)
    )
  )

  (:action start_in_nice
    :parameters ()
    :precondition (trip_not_started)
    :effect (and
      (not (trip_not_started))
      (current_day day_1)
      (current_city nice)
      (occupied_on nice day_1)
      (meeting_satisfied)

      (not (n_count_0))
      (n_count_1)
    )
  )

