(define (domain european_trip_10_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (at ?c - city ?d - day)
    (direct_flight ?from - city ?to - city)

    (trip_finished)

    (counted_reykjavik_0)
    (counted_reykjavik_1)
    (counted_reykjavik_2)
    (counted_reykjavik_3)
    (counted_reykjavik_4)
    (counted_reykjavik_5)

