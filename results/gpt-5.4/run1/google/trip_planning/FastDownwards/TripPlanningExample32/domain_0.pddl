    (counted_riga_2)
    (counted_riga_3)

    (counted_paris_0)
    (counted_paris_1)
    (counted_paris_2)
    (counted_paris_3)
    (counted_paris_4)
  )

  (:action choose_start_reykjavik
    :parameters ()
    :precondition (and
      (current_day day_1)
      (not (at reykjavik day_1))
      (not (at riga day_1))
      (not (at paris day_1))
      (counted_reykjavik_0)
      (counted_riga_0)
      (counted_paris_0)
    )
    :effect (and
      (at reykjavik day_1)
      (not (counted_reykjavik_0))
      (counted_reykjavik_1)
    )
  )

