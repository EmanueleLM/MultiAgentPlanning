(define (domain european_trip_12day_instance)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day count)

  (:predicates
    (current ?d - day)
    (at ?c - city ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (direct ?from - city ?to - city)
    (spent ?c - city ?d - day)

    (porto_count ?n - count)
    (barcelona_count ?n - count)
    (florence_count ?n - count)
    (next_count ?n1 - count ?n2 - count)
  )

  (:action stay_day_porto
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at porto ?d)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (porto_count ?n1)
      (not (spent porto ?d))
    )
    :effect (and
      (spent porto ?d)
      (not (current ?d))
      (current ?d2)
      (not (at porto ?d))
      (at porto ?d2)
      (not (porto_count ?n1))
      (porto_count ?n2)
    )
  )

  (:action stay_day_barcelona
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at barcelona ?d)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (barcelona_count ?n1)
      (not (spent barcelona ?d))
    )
    :effect (and
      (spent barcelona ?d)
      (not (current ?d))
      (current ?d2)
      (not (at barcelona ?d))
      (at barcelona ?d2)
      (not (barcelona_count ?n1))
      (barcelona_count ?n2)
    )
  )

  (:action stay_day_florence
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at florence ?d)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (florence_count ?n1)
      (not (spent florence ?d))
    )
    :effect (and
      (spent florence ?d)
      (not (current ?d))
      (current ?d2)
      (not (at florence ?d))
      (at florence ?d2)
      (not (florence_count ?n1))
      (florence_count ?n2)
    )
  )

  (:action fly_porto_to_barcelona_and_spend
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at porto ?d)
      (direct porto barcelona)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (barcelona_count ?n1)
      (not (spent barcelona ?d))
    )
    :effect (and
      (spent barcelona ?d)
      (not (current ?d))
      (current ?d2)
      (not (at porto ?d))
      (at barcelona ?d2)
      (not (barcelona_count ?n1))
      (barcelona_count ?n2)
    )
  )

  (:action fly_barcelona_to_porto_and_spend
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at barcelona ?d)
      (direct barcelona porto)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (porto_count ?n1)
      (not (spent porto ?d))
    )
    :effect (and
      (spent porto ?d)
      (not (current ?d))
      (current ?d2)
      (not (at barcelona ?d))
      (at porto ?d2)
      (not (porto_count ?n1))
      (porto_count ?n2)
    )
  )

  (:action fly_barcelona_to_florence_and_spend
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at barcelona ?d)
      (direct barcelona florence)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (florence_count ?n1)
      (not (spent florence ?d))
    )
    :effect (and
      (spent florence ?d)
      (not (current ?d))
      (current ?d2)
      (not (at barcelona ?d))
      (at florence ?d2)
      (not (florence_count ?n1))
      (florence_count ?n2)
    )
  )

  (:action fly_florence_to_barcelona_and_spend
    :parameters (?d - day ?d2 - day ?n1 - count ?n2 - count)
    :precondition (and
      (current ?d)
      (at florence ?d)
      (direct florence barcelona)
      (next_day ?d ?d2)
      (next_count ?n1 ?n2)
      (barcelona_count ?n1)
      (not (spent barcelona ?d))
    )
    :effect (and
      (spent barcelona ?d)
      (not (current ?d))
      (current ?d2)
      (not (at florence ?d))
      (at barcelona ?d2)
      (not (barcelona_count ?n1))
      (barcelona_count ?n2)
    )
  )
)