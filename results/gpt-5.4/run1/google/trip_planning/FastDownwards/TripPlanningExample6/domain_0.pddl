(define (domain european_trip_8_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (next_day ?d1 - day ?d2 - day)
    (direct ?from - city ?to - city)
    (current_day ?d - day)
    (assigned ?d - day)
    (at_day ?d - day ?c - city)
    (final_day ?d - day)

    (berlin_count_0)
    (berlin_count_1)
    (berlin_count_2)
    (berlin_count_3)
    (berlin_count_4)

    (munich_count_0)
    (munich_count_1)
    (munich_count_2)
    (munich_count_3)

    (dubrovnik_count_0)
    (dubrovnik_count_1)
    (dubrovnik_count_2)
    (dubrovnik_count_3)
  )

  (:action assign_day1_berlin
    :precondition (and
      (current_day day1)
      (not (assigned day1))
      (berlin_count_0)
    )
    :effect (and
      (assigned day1)
      (at_day day1 berlin)
      (not (current_day day1))
      (current_day day2)
      (not (berlin_count_0))
      (berlin_count_1)
    )
  )

  (:action continue_berlin
    :parameters (?d1 - day ?d2 - day)
    :precondition (and
      (current_day ?d2)
      (next_day ?d1 ?d2)
      (assigned ?d1)
      (at_day ?d1 berlin)
      (not (assigned ?d2))
      (not (final_day ?d2))
      (berlin_count_0)
    )
    :effect (and
      (assigned ?d2)
      (at_day ?d2 berlin)
      (not (berlin_count_0))
      (berlin_count_1)
    )
  )

