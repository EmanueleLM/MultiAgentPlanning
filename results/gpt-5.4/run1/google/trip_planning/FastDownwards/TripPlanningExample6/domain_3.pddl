(define (domain trip_planning_example6)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city
    day
    staylen
  )

  (:predicates
    (direct ?from - city ?to - city)
    (next ?d1 - day ?d2 - day)
    (current_day ?d - day)
    (last_day ?d - day)

    (at ?c - city)

    (required_total ?c - city ?n - staylen)
    (remaining_total ?c - city ?n - staylen)
    (dec_total ?fromn - staylen ?ton - staylen)

    (required_block ?c - city ?n - staylen)
    (block_remaining ?n - staylen)
    (dec_block ?fromn - staylen ?ton - staylen)
    (in_block ?c - city)
    (block_done ?c - city)
    (goal_city ?c - city)

    (conference ?d - day ?c - city)
    (visited ?d - day ?c - city)
  )

  (:action start_block_stay
    :parameters (?d - day ?nd - day ?c - city ?req - staylen ?reqm1 - staylen ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (next ?d ?nd)
      (at ?c)
      (goal_city ?c)
      (required_block ?c ?req)
      (dec_block ?req ?reqm1)
      (block_remaining zero)
      (not (block_done ?c))
      (remaining_total ?c ?tot)
      (dec_total ?tot ?totm1)
      (not (conference ?d berlin))
    )
    :effect (and
      (visited ?d ?c)
      (not (current_day ?d))
      (current_day ?nd)
      (not (remaining_total ?c ?tot))
      (remaining_total ?c ?totm1)
      (not (block_remaining zero))
      (block_remaining ?reqm1)
      (in_block ?c)
      (block_done ?c)
    )
  )

  (:action start_block_fly
    :parameters (?d - day ?nd - day ?from - city ?c - city ?req - staylen ?reqm1 - staylen ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (next ?d ?nd)
      (at ?from)
      (direct ?from ?c)
      (goal_city ?c)
      (required_block ?c ?req)
      (dec_block ?req ?reqm1)
      (block_remaining zero)
      (not (block_done ?c))
      (remaining_total ?c ?tot)
      (dec_total ?tot ?totm1)
      (not (conference ?d berlin))
    )
    :effect (and
      (not (at ?from))
      (at ?c)
      (visited ?d ?c)
      (not (current_day ?d))
      (current_day ?nd)
      (not (remaining_total ?c ?tot))
      (remaining_total ?c ?totm1)
      (not (block_remaining zero))
      (block_remaining ?reqm1)
      (in_block ?c)
      (block_done ?c)
    )
  )

  (:action continue_block
    :parameters (?d - day ?nd - day ?c - city ?b - staylen ?bm1 - staylen ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (next ?d ?nd)
      (at ?c)
      (in_block ?c)
      (block_remaining ?b)
      (dec_block ?b ?bm1)
      (remaining_total ?c ?tot)
      (dec_total ?tot ?totm1)
      (not (conference ?d berlin))
    )
    :effect (and
      (visited ?d ?c)
      (not (current_day ?d))
      (current_day ?nd)
      (not (block_remaining ?b))
      (block_remaining ?bm1)
      (not (remaining_total ?c ?tot))
      (remaining_total ?c ?totm1)
    )
  )

  (:action finish_block
    :parameters (?d - day ?nd - day ?c - city ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (next ?d ?nd)
      (at ?c)
      (in_block ?c)
      (block_remaining one)
      (remaining_total ?c ?tot)
      (dec_total ?tot ?totm1)
      (not (conference ?d berlin))
    )
    :effect (and
      (visited ?d ?c)
      (not (current_day ?d))
      (current_day ?nd)
      (not (block_remaining one))
      (block_remaining zero)
      (not (in_block ?c))
      (not (remaining_total ?c ?tot))
      (remaining_total ?c ?totm1)
    )
  )

  (:action conference_stay
    :parameters (?d - day ?nd - day ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (next ?d ?nd)
      (conference ?d berlin)
      (at berlin)
      (remaining_total berlin ?tot)
      (dec_total ?tot ?totm1)
      (block_remaining zero)
    )
    :effect (and
      (visited ?d berlin)
      (not (current_day ?d))
      (current_day ?nd)
      (not (remaining_total berlin ?tot))
      (remaining_total berlin ?totm1)
    )
  )

  (:action conference_finish_stay
    :parameters (?d - day ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (last_day ?d)
      (conference ?d berlin)
      (at berlin)
      (remaining_total berlin ?tot)
      (dec_total ?tot ?totm1)
      (block_remaining zero)
    )
    :effect (and
      (visited ?d berlin)
      (not (current_day ?d))
      (not (remaining_total berlin ?tot))
      (remaining_total berlin ?totm1)
    )
  )

  (:action conference_fly
    :parameters (?d - day ?nd - day ?from - city ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (next ?d ?nd)
      (conference ?d berlin)
      (at ?from)
      (direct ?from berlin)
      (remaining_total berlin ?tot)
      (dec_total ?tot ?totm1)
      (block_remaining zero)
    )
    :effect (and
      (not (at ?from))
      (at berlin)
      (visited ?d berlin)
      (not (current_day ?d))
      (current_day ?nd)
      (not (remaining_total berlin ?tot))
      (remaining_total berlin ?totm1)
    )
  )

  (:action conference_finish_fly
    :parameters (?d - day ?from - city ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (last_day ?d)
      (conference ?d berlin)
      (at ?from)
      (direct ?from berlin)
      (remaining_total berlin ?tot)
      (dec_total ?tot ?totm1)
      (block_remaining zero)
    )
    :effect (and
      (not (at ?from))
      (at berlin)
      (visited ?d berlin)
      (not (current_day ?d))
      (not (remaining_total berlin ?tot))
      (remaining_total berlin ?totm1)
    )
  )

  (:action finish_block_last_day
    :parameters (?d - day ?c - city ?tot - staylen ?totm1 - staylen)
    :precondition (and
      (current_day ?d)
      (last_day ?d)
      (at ?c)
      (in_block ?c)
      (block_remaining one)
      (remaining_total ?c ?tot)
      (dec_total ?tot ?totm1)
      (not (conference ?d berlin))
    )
    :effect (and
      (visited ?d ?c)
      (not (current_day ?d))
      (not (block_remaining one))
      (block_remaining zero)
      (not (in_block ?c))
      (not (remaining_total ?c ?tot))
      (remaining_total ?c ?totm1)
    )
  )
)