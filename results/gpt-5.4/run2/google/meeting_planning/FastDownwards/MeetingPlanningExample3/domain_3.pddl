(define (domain san_francisco_day_meeting)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    person location time meet_stage route_stage
  )

  (:constants
    traveler - person
    golden_gate_park bayview - location
    bg0 bg1 bg2 bg3 bg4 bg5 bg6 bg7 bg8 bg9 bg10 bg11 bg12 bg13 bg14 bg15 bg16 bg17 bg18 bg19 bg20 bg21 bg22 - route_stage
    gb0 gb1 gb2 gb3 gb4 gb5 gb6 gb7 gb8 gb9 gb10 gb11 gb12 gb13 gb14 gb15 gb16 gb17 gb18 gb19 gb20 gb21 gb22 gb23 - route_stage
  )

  (:predicates
    (at ?p - person ?l - location)
    (current_time ?t - time)
    (meeting_stage ?m - meet_stage)
    (next_time ?t1 - time ?t2 - time)
    (meet_stage_next ?m1 - meet_stage ?m2 - meet_stage)
    (barbara_available_at ?l - location ?t - time)
    (traveling_bg ?s - route_stage)
    (traveling_gb ?s - route_stage)
    (bg_next ?s1 - route_stage ?s2 - route_stage)
    (gb_next ?s1 - route_stage ?s2 - route_stage)
    (bg_final ?s - route_stage)
    (gb_final ?s - route_stage)
  )

  (:action wait_one_minute
    :parameters (?l - location ?t1 - time ?t2 - time)
    :precondition (and
      (at traveler ?l)
      (current_time ?t1)
      (next_time ?t1 ?t2)
      (not (traveling_bg bg0))
      (not (traveling_bg bg1))
      (not (traveling_bg bg2))
      (not (traveling_bg bg3))
      (not (traveling_bg bg4))
      (not (traveling_bg bg5))
      (not (traveling_bg bg6))
      (not (traveling_bg bg7))
