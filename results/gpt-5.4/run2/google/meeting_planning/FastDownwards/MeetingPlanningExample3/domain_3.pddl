      (not (traveling_bg bg12))
      (not (traveling_bg bg13))
      (not (traveling_bg bg14))
      (not (traveling_bg bg15))
      (not (traveling_bg bg16))
      (not (traveling_bg bg17))
      (not (traveling_bg bg18))
      (not (traveling_bg bg19))
      (not (traveling_bg bg20))
      (not (traveling_bg bg21))
      (not (traveling_bg bg22))
      (not (traveling_gb gb0))
      (not (traveling_gb gb1))
      (not (traveling_gb gb2))
      (not (traveling_gb gb3))
      (not (traveling_gb gb4))
      (not (traveling_gb gb5))
      (not (traveling_gb gb6))
      (not (traveling_gb gb7))
      (not (traveling_gb gb8))
      (not (traveling_gb gb9))
      (not (traveling_gb gb10))
      (not (traveling_gb gb11))
      (not (traveling_gb gb12))
      (not (traveling_gb gb13))
      (not (traveling_gb gb14))
      (not (traveling_gb gb15))
      (not (traveling_gb gb16))
      (not (traveling_gb gb17))
      (not (traveling_gb gb18))
      (not (traveling_gb gb19))
      (not (traveling_gb gb20))
      (not (traveling_gb gb21))
      (not (traveling_gb gb22))
      (not (traveling_gb gb23))
    )
    :effect (and
      (not (current_time ?t1))
      (current_time ?t2)
    )
  )

  (:action meet_one_minute
    :parameters (?t1 - time ?t2 - time ?m1 - meet_stage ?m2 - meet_stage)
