    :parameters (?s1 - route_stage ?s2 - route_stage ?t1 - time ?t2 - time)
    :precondition (and
      (traveling_bg ?s1)
      (bg_next ?s1 ?s2)
      (bg_final ?s2)
      (current_time ?t1)
      (next_time ?t1 ?t2)
    )
    :effect (and
      (not (traveling_bg ?s1))
      (not (current_time ?t1))
      (current_time ?t2)
      (at traveler golden_gate_park)
    )
  )

