  (:action travel
    :parameters (?from - location ?to - location ?depart - time ?arrive - time)
    :precondition (and
      (at ?from)
      (current_time ?depart)
      (connected ?from ?to ?depart ?arrive)
      (not (meeting margaret))
    )
    :effect (and
      (not (at ?from))
      (at ?to)
      (not (current_time ?depart))
      (current_time ?arrive)
    )
  )

  (:action start_meeting
    :parameters (?t1 - time ?t2 - time)
    :precondition (and
      (at north_beach)
      (current_time ?t1)
      (friend_at margaret north_beach)
      (available margaret ?t1)
      (next_minute ?t1 ?t2)
      (meeting_progress ms0)
      (not (meeting margaret))
    )
    :effect (and
      (meeting margaret)
      (not (current_time ?t1))
      (current_time ?t2)
      (not (meeting_progress ms0))
      (meeting_progress ms1)
    )
  )

  (:action continue_meeting
    :parameters (?t1 - time ?t2 - time ?s1 - meeting_stage ?s2 - meeting_stage)
    :precondition (and
      (meeting margaret)
      (at north_beach)
      (current_time ?t1)
      (next_minute ?t1 ?t2)
      (available margaret ?t1)
      (meeting_progress ?s1)
      (stage_next ?s1 ?s2)
    )
    :effect (and
      (not (current_time ?t1))
      (current_time ?t2)
      (not (meeting_progress ?s1))
      (meeting_progress ?s2)
    )
  )
)