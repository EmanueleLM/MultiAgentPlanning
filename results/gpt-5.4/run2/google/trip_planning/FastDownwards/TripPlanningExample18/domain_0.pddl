(define (domain european_trip_11_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day token
  )

  (:predicates
    (direct ?from - city ?to - city)
    (next_day ?d1 - day ?d2 - day)
    (current_day ?d - day)
    (at ?c - city)
    (occupied ?d - day ?c - city)
    (token_for_city ?t - token ?c - city)
    (token_used ?t - token)
    (started)
    (met_friends)
  )

  (:action assign_first_day
    :parameters (?c - city ?t - token)
    :precondition (and
      (current_day day_1)
      (not (started))
      (token_for_city ?t ?c)
      (not (token_used ?t))
    )
    :effect (and
      (started)
      (occupied day_1 ?c)
      (at ?c)
      (token_used ?t)
    )
  )

  (:action stay_next_day_nonwindow
    :parameters (?d1 - day ?d2 - day ?c - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?c)
      (token_for_city ?t ?c)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (not (met_friends))
    )
    :effect (and
      (occupied ?d2 ?c)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
    )
  )

  (:action stay_next_day_nonwindow_after_meeting
    :parameters (?d1 - day ?d2 - day ?c - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?c)
      (token_for_city ?t ?c)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (met_friends)
    )
    :effect (and
      (occupied ?d2 ?c)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
    )
  )

  (:action fly_next_day_nonwindow
    :parameters (?d1 - day ?d2 - day ?from - city ?to - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?from)
      (direct ?from ?to)
      (token_for_city ?t ?to)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (not (met_friends))
    )
    :effect (and
      (occupied ?d2 ?to)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at ?from))
      (at ?to)
    )
  )

  (:action fly_next_day_nonwindow_after_meeting
    :parameters (?d1 - day ?d2 - day ?from - city ?to - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?from)
      (direct ?from ?to)
      (token_for_city ?t ?to)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (met_friends)
    )
    :effect (and
      (occupied ?d2 ?to)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at ?from))
      (at ?to)
    )
  )

  (:action stay_next_day_window_other
    :parameters (?d1 - day ?d2 - day ?c - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?c)
      (token_for_city ?t ?c)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (not (met_friends))
    )
    :effect (and
      (occupied ?d2 ?c)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
    )
  )

  (:action stay_next_day_window_other_after_meeting
    :parameters (?d1 - day ?d2 - day ?c - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?c)
      (token_for_city ?t ?c)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (met_friends)
    )
    :effect (and
      (occupied ?d2 ?c)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
    )
  )

  (:action fly_next_day_window_to_other
    :parameters (?d1 - day ?d2 - day ?from - city ?to - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?from)
      (direct ?from ?to)
      (token_for_city ?t ?to)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (not (met_friends))
    )
    :effect (and
      (occupied ?d2 ?to)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at ?from))
      (at ?to)
    )
  )

  (:action fly_next_day_window_to_other_after_meeting
    :parameters (?d1 - day ?d2 - day ?from - city ?to - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?from)
      (direct ?from ?to)
      (token_for_city ?t ?to)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
      (met_friends)
    )
    :effect (and
      (occupied ?d2 ?to)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at ?from))
      (at ?to)
    )
  )

  (:action stay_next_day_window_bucharest
    :parameters (?d1 - day ?d2 - day ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at bucharest)
      (token_for_city ?t bucharest)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
    )
    :effect (and
      (occupied ?d2 bucharest)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
      (met_friends)
    )
  )

  (:action fly_next_day_window_to_bucharest
    :parameters (?d1 - day ?d2 - day ?from - city ?t - token)
    :precondition (and
      (started)
      (current_day ?d1)
      (next_day ?d1 ?d2)
      (at ?from)
      (direct ?from bucharest)
      (token_for_city ?t bucharest)
      (not (token_used ?t))
      (not (occupied ?d2 amsterdam))
      (not (occupied ?d2 vilnius))
      (not (occupied ?d2 bucharest))
    )
    :effect (and
      (occupied ?d2 bucharest)
      (token_used ?t)
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at ?from))
      (at bucharest)
      (met_friends)
    )
  )
)