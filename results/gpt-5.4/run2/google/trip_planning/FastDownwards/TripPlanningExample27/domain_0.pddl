(define (domain european_trip_14_days_instance)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day slot)
  (:predicates
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (at ?c - city)
    (direct_flight ?from - city ?to - city)
    (occupied ?c - city ?d - day)

    (slot_for_city ?s - slot ?c - city)
    (slot_next ?s1 - slot ?s2 - slot)
    (slot_head ?c - city ?s - slot)
    (slot_tail ?c - city ?s - slot)
    (slot_open ?c - city ?s - slot)
    (slot_used ?s - slot)
  )

  (:action stay_to_next_day
    :parameters (?c - city ?d - day ?d2 - day ?s - slot)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?d2)
      (at ?c)
      (slot_open ?c ?s)
      (slot_for_city ?s ?c)
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?d2)
      (occupied ?c ?d2)
      (slot_used ?s)
      (not (slot_open ?c ?s))
    )
  )

  (:action stay_to_next_day_open_next
    :parameters (?c - city ?d - day ?d2 - day ?s - slot ?s2 - slot)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?d2)
      (at ?c)
      (slot_open ?c ?s)
      (slot_for_city ?s ?c)
      (slot_next ?s ?s2)
      (slot_for_city ?s2 ?c)
      (not (slot_tail ?c ?s))
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?d2)
      (occupied ?c ?d2)
      (slot_used ?s)
      (not (slot_open ?c ?s))
      (slot_open ?c ?s2)
    )
  )

  (:action fly_to_next_day
    :parameters (?from - city ?to - city ?d - day ?d2 - day ?s - slot)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?d2)
      (at ?from)
      (direct_flight ?from ?to)
      (slot_open ?to ?s)
      (slot_for_city ?s ?to)
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?d2)
      (not (at ?from))
      (at ?to)
      (occupied ?to ?d2)
      (slot_used ?s)
      (not (slot_open ?to ?s))
    )
  )

  (:action fly_to_next_day_open_next
    :parameters (?from - city ?to - city ?d - day ?d2 - day ?s - slot ?s2 - slot)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?d2)
      (at ?from)
      (direct_flight ?from ?to)
      (slot_open ?to ?s)
      (slot_for_city ?s ?to)
      (slot_next ?s ?s2)
      (slot_for_city ?s2 ?to)
      (not (slot_tail ?to ?s))
    )
    :effect (and
      (not (current_day ?d))
      (current_day ?d2)
      (not (at ?from))
      (at ?to)
      (occupied ?to ?d2)
      (slot_used ?s)
      (not (slot_open ?to ?s))
      (slot_open ?to ?s2)
    )
  )
)