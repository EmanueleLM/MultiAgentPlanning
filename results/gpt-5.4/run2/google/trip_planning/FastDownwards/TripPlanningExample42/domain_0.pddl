(define (domain european_trip_11_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day count
  )

  (:predicates
    (next_day ?d1 - day ?d2 - day)
    (direct ?from - city ?to - city)

    (assigned ?d - day)
    (current_day ?d - day)
    (at_city ?d - day ?c - city)
    (last_city ?c - city)
    (planning_done)
    (met_in_paris_window)

    (paris_count ?n - count)
    (nice_count ?n - count)
    (mykonos_count ?n - count)
    (count_succ ?n1 - count ?n2 - count)
  )

  (:action assign_day_1_paris
    :parameters (?n_old - count ?n_new - count)
    :precondition (and
      (current_day day_1)
      (not (assigned day_1))
      (paris_count ?n_old)
      (count_succ ?n_old ?n_new)
    )
    :effect (and
      (assigned day_1)
      (at_city day_1 paris)
      (not (current_day day_1))
      (current_day day_2)
      (last_city paris)
      (not (paris_count ?n_old))
      (paris_count ?n_new)
      (met_in_paris_window)
    )
  )

  (:action assign_day_1_nice
    :parameters (?n_old - count ?n_new - count)
    :precondition (and
      (current_day day_1)
      (not (assigned day_1))
      (nice_count ?n_old)
      (count_succ ?n_old ?n_new)
    )
    :effect (and
      (assigned day_1)
      (at_city day_1 nice)
      (not (current_day day_1))
      (current_day day_2)
      (last_city nice)
      (not (nice_count ?n_old))
      (nice_count ?n_new)
    )
  )

  (:action assign_day_1_mykonos
    :parameters (?n_old - count ?n_new - count)
    :precondition (and
      (current_day day_1)
      (not (assigned day_1))
      (mykonos_count ?n_old)
      (count_succ ?n_old ?n_new)
    )
    :effect (and
      (assigned day_1)
      (at_city day_1 mykonos)
      (not (current_day day_1))
      (current_day day_2)
      (last_city mykonos)
      (not (mykonos_count ?n_old))
      (mykonos_count ?n_new)
    )
  )

