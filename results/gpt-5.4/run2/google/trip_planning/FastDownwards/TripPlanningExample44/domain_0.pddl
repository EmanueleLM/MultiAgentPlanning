(define (domain european_trip_17_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (direct_flight ?from - city ?to - city)

    (day_assigned ?d - day)

    (spent_day_in_rome ?d - day)
    (spent_day_in_lyon ?d - day)
    (spent_day_in_zurich ?d - day)

    (wedding_window_day ?d - day)
    (wedding_attended)

    (rome_need_1) (rome_need_2) (rome_need_3) (rome_need_4) (rome_need_5) (rome_need_6)
    (lyon_need_1) (lyon_need_2) (lyon_need_3) (lyon_need_4) (lyon_need_5) (lyon_need_6)
    (zurich_need_1) (zurich_need_2) (zurich_need_3) (zurich_need_4) (zurich_need_5) (zurich_need_6) (zurich_need_7)
  )

  (:action flight
    :parameters (?from - city ?to - city)
    :precondition (and
      (at ?from)
      (direct_flight ?from ?to)
      (not (at ?to))
    )
    :effect (and
      (not (at ?from))
      (at ?to)
    )
  )

  (:action stay_in_rome_fill_1
    :parameters (?d - day ?d_next - day)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?d_next)
      (at rome)
      (not (day_assigned ?d))
      (not (rome_need_1))
      (not (spent_day_in_rome ?d))
      (not (spent_day_in_lyon ?d))
      (not (spent_day_in_zurich ?d))
    )
    :effect (and
      (day_assigned ?d)
      (spent_day_in_rome ?d)
      (rome_need_1)
      (not (current_day ?d))
      (current_day ?d_next)
    )
  )

