(define (domain san_francisco_day_meeting)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    location person time stage
  )

  (:predicates
    (at ?l - location)
    (road ?from - location ?to - location)
    (current_time ?t - time)
    (next_time ?t1 - time ?t2 - time)
    (person_at ?p - person ?l - location)
    (available ?p - person ?t - time)
    (traveling ?from - location ?to - location)
    (travel_phase ?s - stage)
    (meeting_phase ?s - stage)
    (stage_next ?s1 - stage ?s2 - stage)
    (met_required ?p - person)
  )

  (:action wait_one_minute
    :parameters (?l - location ?t1 - time ?t2 - time)
    :precondition (and
      (at ?l)
      (current_time ?t1)
      (next_time ?t1 ?t2)
      (not (traveling nob_hill alamo_square))
      (not (traveling alamo_square nob_hill))
      (not (meeting_phase s1))
      (not (meeting_phase s2))
      (not (meeting_phase s3))
      (not (meeting_phase s4))
      (not (meeting_phase s5))
      (not (meeting_phase s6))
      (not (meeting_phase s7))
      (not (meeting_phase s8))
      (not (meeting_phase s9))
      (not (meeting_phase s10))
      (not (meeting_phase s11))
      (not (meeting_phase s12))
      (not (meeting_phase s13))
      (not (meeting_phase s14))
      (not (meeting_phase s15))
    )
    :effect (and
      (not (current_time ?t1))
      (current_time ?t2)
    )
  )

  (:action start_travel
    :parameters (?from - location ?to - location)
    :precondition (and
      (at ?from)
      (road ?from ?to)
      (not (traveling nob_hill alamo_square))
      (not (traveling alamo_square nob_hill))
      (not (meeting_phase s1))
      (not (meeting_phase s2))
      (not (meeting_phase s3))
      (not (meeting_phase s4))
      (not (meeting_phase s5))
      (not (meeting_phase s6))
      (not (meeting_phase s7))
      (not (meeting_phase s8))
      (not (meeting_phase s9))
      (not (meeting_phase s10))
      (not (meeting_phase s11))
      (not (meeting_phase s12))
      (not (meeting_phase s13))
      (not (meeting_phase s14))
      (not (meeting_phase s15))
    )
    :effect (and
      (not (at ?from))
      (traveling ?from ?to)
      (travel_phase s0)
    )
  )

  (:action travel_step
    :parameters (?from - location ?to - location ?s1 - stage ?s2 - stage ?t1 - time ?t2 - time)
    :precondition (and
      (traveling ?from ?to)
      (travel_phase ?s1)
      (stage_next ?s1 ?s2)
      (current_time ?t1)
      (next_time ?t1 ?t2)
      (not (travel_phase s11))
    )
    :effect (and
      (not (travel_phase ?s1))
      (travel_phase ?s2)
      (not (current_time ?t1))
      (current_time ?t2)
    )
  )

  (:action finish_travel
    :parameters (?from - location ?to - location)
    :precondition (and
      (traveling ?from ?to)
      (travel_phase s11)
    )
    :effect (and
      (not (traveling ?from ?to))
      (not (travel_phase s11))
      (at ?to)
    )
  )

  (:action start_meeting
    :parameters (?p - person ?l - location ?t1 - time ?t2 - time)
    :precondition (and
      (at ?l)
      (person_at ?p ?l)
      (current_time ?t1)
      (next_time ?t1 ?t2)
      (available ?p ?t1)
      (not (traveling nob_hill alamo_square))
      (not (traveling alamo_square nob_hill))
      (not (meeting_phase s1))
      (not (meeting_phase s2))
      (not (meeting_phase s3))
      (not (meeting_phase s4))
      (not (meeting_phase s5))
      (not (meeting_phase s6))
      (not (meeting_phase s7))
      (not (meeting_phase s8))
      (not (meeting_phase s9))
      (not (meeting_phase s10))
      (not (meeting_phase s11))
      (not (meeting_phase s12))
      (not (meeting_phase s13))
      (not (meeting_phase s14))
      (not (meeting_phase s15))
      (not (met_required ?p))
    )
    :effect (and
      (meeting_phase s1)
      (not (current_time ?t1))
      (current_time ?t2)
    )
  )

  (:action continue_meeting
    :parameters (?p - person ?l - location ?s1 - stage ?s2 - stage ?t1 - time ?t2 - time)
    :precondition (and
      (at ?l)
      (person_at ?p ?l)
      (meeting_phase ?s1)
      (stage_next ?s1 ?s2)
      (current_time ?t1)
      (next_time ?t1 ?t2)
      (available ?p ?t1)
      (not (traveling nob_hill alamo_square))
      (not (traveling alamo_square nob_hill))
      (not (meeting_phase s15))
    )
    :effect (and
      (not (meeting_phase ?s1))
      (meeting_phase ?s2)
      (not (current_time ?t1))
      (current_time ?t2)
    )
  )

  (:action finish_meeting
    :parameters (?p - person ?l - location)
    :precondition (and
      (at ?l)
      (person_at ?p ?l)
      (meeting_phase s15)
    )
    :effect (and
      (not (meeting_phase s15))
      (met_required ?p)
    )
  )
)