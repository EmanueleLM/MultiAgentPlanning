(define (domain european_trip_9_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day oslo_count dublin_count valencia_count
  )

  (:predicates
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (last_day ?d - day)
    (trip_complete)

    (at ?c - city)
    (direct_flight ?from - city ?to - city)

    (day_assigned ?d - day)
    (window_day ?d - day)

    (start_pending)

    (oslo_progress ?n - oslo_count)
    (dublin_progress ?n - dublin_count)
    (valencia_progress ?n - valencia_count)

    (oslo_step ?from - oslo_count ?to - oslo_count)
    (dublin_step ?from - dublin_count ?to - dublin_count)
    (valencia_step ?from - valencia_count ?to - valencia_count)

    (valencia_window_satisfied)
  )

  (:action start_in_oslo
    :parameters ()
    :precondition (and
      (start_pending)
      (current_day d1)
      (not (trip_complete))
    )
    :effect (and
      (not (start_pending))
      (at oslo)
    )
  )

  (:action start_in_dublin
    :parameters ()
    :precondition (and
      (start_pending)
      (current_day d1)
      (not (trip_complete))
    )
    :effect (and
      (not (start_pending))
      (at dublin)
    )
  )

  (:action start_in_valencia
    :parameters ()
    :precondition (and
      (start_pending)
      (current_day d1)
      (not (trip_complete))
    )
    :effect (and
      (not (start_pending))
      (at valencia)
    )
  )

  (:action spend_day_stay_oslo
    :parameters (?d - day ?dnext - day ?ko1 - oslo_count ?ko2 - oslo_count)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?dnext)
      (at oslo)
      (not (start_pending))
      (not (day_assigned ?d))
      (not (trip_complete))
      (oslo_progress ?ko1)
      (oslo_step ?ko1 ?ko2)
      (not (last_day ?d))
    )
    :effect (and
      (day_assigned ?d)
      (not (current_day ?d))
      (current_day ?dnext)
      (not (oslo_progress ?ko1))
      (oslo_progress ?ko2)
    )
  )

  (:action spend_day_fly_dublin_to_oslo
    :parameters (?d - day ?dnext - day ?ko1 - oslo_count ?ko2 - oslo_count)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?dnext)
      (at dublin)
      (direct_flight dublin oslo)
      (not (start_pending))
      (not (day_assigned ?d))
      (not (trip_complete))
      (oslo_progress ?ko1)
      (oslo_step ?ko1 ?ko2)
      (not (last_day ?d))
    )
    :effect (and
      (day_assigned ?d)
      (not (current_day ?d))
      (current_day ?dnext)
      (not (at dublin))
      (at oslo)
      (not (oslo_progress ?ko1))
      (oslo_progress ?ko2)
    )
  )

