(define (domain european_trip_15_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day count_slot
  )

  (:predicates
    (next_day ?d1 - day ?d2 - day)
    (current_day ?d - day)
    (day_assigned ?d - day)
    (at_city_on_day ?c - city ?d - day)
    (city_of_previous_day ?c - city)
    (direct_flight ?from - city ?to - city)

    (first_vienna_slot ?s - count_slot)
    (next_vienna_slot ?s1 - count_slot ?s2 - count_slot)
    (vienna_slot_available ?s - count_slot)
    (vienna_slot_used ?s - count_slot)

    (first_vilnius_slot ?s - count_slot)
    (next_vilnius_slot ?s1 - count_slot ?s2 - count_slot)
    (vilnius_slot_available ?s - count_slot)
    (vilnius_slot_used ?s - count_slot)

    (first_valencia_slot ?s - count_slot)
