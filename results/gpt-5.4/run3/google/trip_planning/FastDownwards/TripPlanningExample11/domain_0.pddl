    (valencia_slot_available ?s - count_slot)
    (valencia_slot_used ?s - count_slot)
  )

  (:action assign_first_day_vienna_nonfinal
    :parameters (?d - day ?dnext - day ?s - count_slot ?snext - count_slot)
    :precondition (and
      (current_day ?d)
      (next_day ?d ?dnext)
      (not (day_assigned ?d))
      (vienna_slot_available ?s)
      (next_vienna_slot ?s ?snext)
    )
    :effect (and
      (day_assigned ?d)
      (at_city_on_day vienna ?d)
      (not (current_day ?d))
      (current_day ?dnext)
      (city_of_previous_day vienna)
      (vienna_slot_used ?s)
      (not (vienna_slot_available ?s))
      (vienna_slot_available ?snext)
    )
  )

