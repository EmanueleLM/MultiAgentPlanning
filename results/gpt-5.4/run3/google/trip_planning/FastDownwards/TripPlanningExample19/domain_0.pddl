(define (domain trip_europe_9_days_instance)
  (:requirements :strips :typing :negative-preconditions)
  (:types city day count2 count3 count6)

  (:predicates
    (at ?c - city ?d - day)
    (direct ?from - city ?to - city)
    (next ?d1 - day ?d2 - day)
    (assigned ?d - day)
    (current_day ?d - day)
    (count_brussels ?n - count2)
    (count_valencia ?n - count3)
    (count_nice ?n - count6)
    (friends_met)
  )

  (:action choose_start_brussels
    :parameters ()
    :precondition (and
      (current_day day_1)
      (not (assigned day_1))
      (count_brussels b0)
      (count_valencia v0)
      (count_nice n0)
    )
    :effect (and
      (at brussels day_1)
      (assigned day_1)
      (not (count_brussels b0))
      (count_brussels b1)
    )
  )

  (:action choose_start_valencia
    :parameters ()
    :precondition (and
      (current_day day_1)
      (not (assigned day_1))
