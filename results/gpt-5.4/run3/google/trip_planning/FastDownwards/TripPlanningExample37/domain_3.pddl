  (:action start_in_reykjavik
    :parameters ()
    :precondition (and
      (not (started))
      (current_day day_1)
      (free day_1)
    )
    :effect (and
      (started)
      (at reykjavik day_1)
      (not (free day_1))
      (not (need_rk_6))
      (need_rk_5)
    )
  )

