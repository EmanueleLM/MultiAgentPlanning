(define (domain european_trip_5_day_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (direct_flight ?from - city ?to - city)
    (next_day ?d1 - day ?d2 - day)
    (current_day ?d - day)
    (at ?c - city)
    (spent_day_in ?d - day ?c - city)
    (day_assigned ?d - day)
    (start_choice_pending)
    (started)
    (used_city_count_0)
    (used_city_count_1)
    (used_city_count_2)
    (used_city_count_3)
    (city_used geneva)
    (city_used madrid)
    (city_used venice)
  )

  (:action choose_start_geneva
    :parameters ()
    :precondition (and
      (start_choice_pending)
      (not (started))
      (used_city_count_0)
      (not (city_used geneva))
    )
    :effect (and
      (at geneva)
      (started)
      (not (start_choice_pending))
      (not (used_city_count_0))
      (used_city_count_1)
      (city_used geneva)
    )
  )

  (:action choose_start_madrid
