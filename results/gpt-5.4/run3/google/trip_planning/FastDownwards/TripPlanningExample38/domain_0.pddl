  (:action stay_for_day
    :parameters (?d - day ?dnext - day ?c - city)
    :precondition (and
      (started)
      (current_day ?d)
      (next_day ?d ?dnext)
      (at ?c)
      (not (day_assigned ?d))
    )
    :effect (and
      (spent_day_in ?d ?c)
      (day_assigned ?d)
      (not (current_day ?d))
      (current_day ?dnext)
    )
  )

  (:action final_stay_for_day
    :parameters (?d - day ?c - city)
    :precondition (and
      (started)
      (current_day ?d)
      (at ?c)
      (not (day_assigned ?d))
    )
    :effect (and
      (spent_day_in ?d ?c)
      (day_assigned ?d)
      (not (current_day ?d))
    )
  )

  (:action fly_for_day_known_city_1_geneva_to_madrid
