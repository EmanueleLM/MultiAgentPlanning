  (:action stay_porto_from_1
    :parameters ()
    :precondition (and
      (started)
      (current_day day1)
      (next_day day1 day2)
      (at porto day1)
      (porto_count_1)
      (not (at porto day2))
      (not (at barcelona day2))
      (not (at florence day2))
    )
    :effect (and
      (not (current_day day1))
      (current_day day2)
      (at porto day2)
      (not (porto_count_1))
