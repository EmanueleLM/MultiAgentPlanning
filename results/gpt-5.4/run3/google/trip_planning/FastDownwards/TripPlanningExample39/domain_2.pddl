(define (domain european_trip_12_days_instance)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (direct ?from - city ?to - city)
    (next_day ?d - day ?nd - day)
    (current_day ?d - day)
    (at ?c - city ?d - day)
    (visited_in_window_porto)
    (started)
    (porto_count_0)
    (porto_count_1)
    (porto_count_2)
    (porto_count_3)
    (barcelona_count_0)
    (barcelona_count_1)
    (barcelona_count_2)
    (barcelona_count_3)
    (barcelona_count_4)
    (barcelona_count_5)
    (barcelona_count_6)
    (barcelona_count_7)
    (florence_count_0)
    (florence_count_1)
    (florence_count_2)
    (florence_count_3)
    (florence_count_4)
  )

  (:action start_in_porto
    :parameters ()
    :precondition (and
      (current_day d1)
      (not (started))
      (porto_count_0)
    )
    :effect (and
      (started)
      (at porto d1)
      (not (porto_count_0))
      (porto_count_1)
      (visited_in_window_porto)
    )
  )

