(define (domain trip_planning_example39)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city
    day
  )

  (:predicates
    (direct ?from - city ?to - city)
    (next ?d1 - day ?d2 - day)
    (current_day ?d - day)
    (at ?c - city)
    (visited ?c - city ?d - day)
    (count_porto ?n - day)
    (count_barcelona ?n - day)
    (count_florence ?n - day)
    (window_day ?d - day)
    (visited_porto_in_window)
  )

  (:action start_in_porto
    :parameters ()
    :precondition (and
      (current_day d1)
      (not (at porto))
      (not (at barcelona))
      (not (at florence))
      (not (visited porto d1))
      (not (visited barcelona d1))
      (not (visited florence d1))
    )
    :effect (and
      (at porto)
      (visited porto d1)
      (visited_porto_in_window)
    )
  )

  (:action start_in_barcelona
    :parameters ()
    :precondition (and
      (current_day d1)
      (not (at porto))
      (not (at barcelona))
      (not (at florence))
      (not (visited porto d1))
      (not (visited barcelona d1))
      (not (visited florence d1))
    )
    :effect (and
      (at barcelona)
      (visited barcelona d1)
    )
  )

  (:action start_in_florence
    :parameters ()
    :precondition (and
      (current_day d1)
      (not (at porto))
      (not (at barcelona))
      (not (at florence))
      (not (visited porto d1))
      (not (visited barcelona d1))
      (not (visited florence d1))
    )
    :effect (and
      (at florence)
      (visited florence d1)
    )
  )

  (:action stay_porto
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (at porto)
      (visited porto ?d1)
      (count_porto ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (visited porto ?d2)
      (not (count_porto ?n1))
      (count_porto ?n2)
    )
  )

  (:action stay_porto_in_window
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (window_day ?d2)
      (at porto)
      (visited porto ?d1)
      (count_porto ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (visited porto ?d2)
      (not (count_porto ?n1))
      (count_porto ?n2)
      (visited_porto_in_window)
    )
  )

  (:action stay_barcelona
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (at barcelona)
      (visited barcelona ?d1)
      (count_barcelona ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (visited barcelona ?d2)
      (not (count_barcelona ?n1))
      (count_barcelona ?n2)
    )
  )

  (:action stay_florence
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (at florence)
      (visited florence ?d1)
      (count_florence ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (visited florence ?d2)
      (not (count_florence ?n1))
      (count_florence ?n2)
    )
  )

  (:action fly_porto_to_barcelona
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (at porto)
      (direct porto barcelona)
      (visited porto ?d1)
      (count_barcelona ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at porto))
      (at barcelona)
      (visited barcelona ?d2)
      (not (count_barcelona ?n1))
      (count_barcelona ?n2)
    )
  )

  (:action fly_barcelona_to_porto
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (window_day ?d2)
      (at barcelona)
      (direct barcelona porto)
      (visited barcelona ?d1)
      (count_porto ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at barcelona))
      (at porto)
      (visited porto ?d2)
      (not (count_porto ?n1))
      (count_porto ?n2)
      (visited_porto_in_window)
    )
  )

  (:action fly_barcelona_to_florence
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (at barcelona)
      (direct barcelona florence)
      (visited barcelona ?d1)
      (count_florence ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at barcelona))
      (at florence)
      (visited florence ?d2)
      (not (count_florence ?n1))
      (count_florence ?n2)
    )
  )

  (:action fly_florence_to_barcelona
    :parameters (?d1 - day ?d2 - day ?n1 - day ?n2 - day)
    :precondition (and
      (current_day ?d1)
      (next ?d1 ?d2)
      (at florence)
      (direct florence barcelona)
      (visited florence ?d1)
      (count_barcelona ?n1)
      (next ?n1 ?n2)
      (not (visited porto ?d2))
      (not (visited barcelona ?d2))
      (not (visited florence ?d2))
    )
    :effect (and
      (not (current_day ?d1))
      (current_day ?d2)
      (not (at florence))
      (at barcelona)
      (visited barcelona ?d2)
      (not (count_barcelona ?n1))
      (count_barcelona ?n2)
    )
  )
)