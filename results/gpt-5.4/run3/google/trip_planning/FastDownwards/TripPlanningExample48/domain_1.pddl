(define (domain european_trip_4_days)
  (:requirements :strips :typing :negative-preconditions)

  (:types city day)

  (:predicates
    (at ?c - city)
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (direct_flight ?from - city ?to - city)
    (visited_on ?c - city ?d - day)
    (start)
    (m_count_0)
    (m_count_1)
    (m_count_2)
    (s_count_0)
    (s_count_1)
    (s_count_2)
    (g_count_0)
    (g_count_1)
    (g_count_2)
    (met_friend_in_window)
    (trip_complete)
  )

  (:action initialize_day_1_at_manchester_from_m0_s0_g0
    :parameters ()
    :precondition (and
      (start)
      (m_count_0)
      (s_count_0)
      (g_count_0)
      (not (visited_on manchester day_1))
      (not (visited_on split day_1))
      (not (visited_on geneva day_1))
    )
    :effect (and
      (not (start))
