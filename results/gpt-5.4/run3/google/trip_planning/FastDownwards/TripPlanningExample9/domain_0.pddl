(define (domain european_trip_10_days)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    city day
  )

  (:predicates
    (current_day ?d - day)
    (next_day ?d1 - day ?d2 - day)
    (workshop_day ?d - day)

    (at ?c - city)

    (direct_flight ?from - city ?to - city)

    (spent ?d - day ?c - city)

    (trip_not_started)
    (workshop_done)

    (frankfurt_count_0)
    (frankfurt_count_1)
    (frankfurt_count_2)
    (frankfurt_count_3)

    (bucharest_count_0)
    (bucharest_count_1)
    (bucharest_count_2)
    (bucharest_count_3)

    (stuttgart_count_0)
    (stuttgart_count_1)
    (stuttgart_count_2)
    (stuttgart_count_3)
    (stuttgart_count_4)
    (stuttgart_count_5)
    (stuttgart_count_6)
  )

  (:action start_in_bucharest
    :parameters (?dnext - day)
    :precondition (and
      (trip_not_started)
      (current_day day1)
      (next_day day1 ?dnext)
      (bucharest_count_0)
      (not (spent day1 bucharest))
      (not (spent day1 frankfurt))
      (not (spent day1 stuttgart))
    )
    :effect (and
      (not (trip_not_started))
      (spent day1 bucharest)
      (not (current_day day1))
      (current_day ?dnext)
      (at bucharest)
      (not (bucharest_count_0))
      (bucharest_count_1)
    )
  )

  (:action start_in_frankfurt
